// Purple runtime (extends Pink with reflection)
// Implements the conceptually infinite tower from "Collapsing Towers"

// =============================================================================
// Pink Base Runtime (copied for self-containment)
// =============================================================================

// Error constructor with symbol payload
@pink_err = λ&msg. #Err{msg}

@pink_env_head = λe. %env = e; λ{#CON: λ&a. λ&b. a; #NIL: @pink_err(#env)}(env)
@pink_env_tail = λe. %env = e; λ{#CON: λ&a. λ&b. b; #NIL: @pink_err(#env)}(env)

@pink_env_get = λe. λi.
  %env = e; %idx = i;
  λ{0: @pink_env_head(env);
     λ&n. @pink_env_get(@pink_env_tail(env))(n - 1)}(idx)

@pink_reify = λv.
  λ{
    #Cst: λ&n. #Lit{n}
    #Sym: λ&s. #Sym{s}
    #CHR: λ&c. #CHR{c}
    #CON: λ&a. λ&b. #CON{@pink_reify(a), @pink_reify(b)}
    #NIL: #NIL
    #Cod: λ&e. #Cod{e}
    #Clo: λ&env. λ&body.
      %cv = @pink_evalc(#CON{#Cod{#Var{0}}, env})(body);
      λ{#Cod: λ&code. #Lam{code}; _ : @pink_err(#rfy)}(cv)
    #CloR: λ&env. λ&body.
      %cv = @pink_evalc(#CON{#Cod{#Var{0}}, #CON{#Cod{#Var{1}}, env}})(body);
      λ{#Cod: λ&code. #LamR{code}; _ : @pink_err(#rfy)}(cv)
    _ : @pink_err(#rfy)
  }(v)

@pink_lift = λ&v.
  λ{
    #Cod: λ&code. #Cod{code}
    _ : λ&u. #Cod{@pink_reify(v)}
  }(v)

@pink_apply = λf. λx.
  %vf = f; %vx = x;
  λ{
    #Clo: λ&cenv. λ&body. @pink_eval(#CON{vx, cenv})(body)
    #CloR: λ&cenv. λ&body. @pink_eval(#CON{vx, #CON{vf, cenv}})(body)
    #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
    _ : @pink_err(#app)
  }(vf)

// Pink evaluator - uses MOV for efficient bindings, direct @-recursion
@pink_eval = λe. λexp.
  %env = e;
  λ{
    #Lit: λ&n. #Cst{n}
    #Sym: λ&s. #Sym{s}
    #Var: λ&n. @pink_env_get(env)(n)
    #Lam: λ&body. #Clo{env, body}
    #LamR: λ&body. #CloR{env, body}
    #App: λ&f. λ&x.
      %vf = @pink_eval(env)(f);
      %vx = @pink_eval(env)(x);
      @pink_apply(vf)(vx)
    #Let: λ&val. λ&body.
      %vv = @pink_eval(env)(val);
      @pink_eval(#CON{vv, env})(body)
    #Mov: λ&val. λ&body.
      %vv = @pink_eval(env)(val);
      @pink_eval(#CON{vv, env})(body)
    #If: λ&c. λ&t. λ&e.
      %vc = @pink_eval(env)(c);
      λ{
        #Cst: λ&n. λ{0: @pink_eval(env)(e); λ&m. @pink_eval(env)(t)}(n)
        #Cod: λ&cc.
          %vt = @pink_evalc(env)(t);
          %ve = @pink_evalc(env)(e);
          λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
        _ : @pink_err(#if)
      }(vc)
    #Lft: λ&e.
      %v = @pink_eval(env)(e);
      @pink_lift(v)
    #Run: λ&b. λ&e.
      %vb = @pink_eval(env)(b);
      λ{
        #Cod: λ&bc.
          %vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
        _ : λ&u.
          %vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. @pink_eval(env)(ec); _ : @pink_err(#run)}(vc)
      }(vb)
    #Cod: λ&e. #Cod{e}
    #Add: λ&a. λ&b.
      %va = @pink_eval(env)(a);
      %vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na + nb)}; _ : @pink_err(#add)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
        _ : @pink_err(#add)
      }(va)
    #Sub: λ&a. λ&b.
      %va = @pink_eval(env)(a);
      %vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na - nb)}; _ : @pink_err(#sub)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
        _ : @pink_err(#sub)
      }(va)
    #Mul: λ&a. λ&b.
      %va = @pink_eval(env)(a);
      %vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na * nb)}; _ : @pink_err(#mul)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
        _ : @pink_err(#mul)
      }(va)
    #Eql: λ&a. λ&b.
      %va = @pink_eval(env)(a);
      %vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na == nb)}; _ : @pink_err(#eql)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
        _ : @pink_err(#eql)
      }(va)
    #CON: λ&a. λ&b.
      %va = @pink_eval(env)(a);
      %vb = @pink_eval(env)(b);
      λ{
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
        _ : λ&u. #CON{va, vb}
      }(va)
    #NIL: #NIL
    #CHR: λ&c. #CHR{c}
    #Fst: λ&p.
      %vp = @pink_eval(env)(p);
      λ{
        #CON: λ&a. λ&b. a
        #Cod: λ&pc. #Cod{#Fst{pc}}
        _ : @pink_err(#fst)
      }(vp)
    #Snd: λ&p.
      %vp = @pink_eval(env)(p);
      λ{
        #CON: λ&a. λ&b. b
        #Cod: λ&pc. #Cod{#Snd{pc}}
        _ : @pink_err(#snd)
      }(vp)
    _ : @pink_err(#exp)
  }(exp)

// Pink compile-mode evaluator - lifts values to code
@pink_evalc = λe. λexp.
  %env = e;
  λ{
    #Lit: λ&n. @pink_lift(#Cst{n})
    #Sym: λ&s. @pink_lift(#Sym{s})
    #Var: λ&n. @pink_lift(@pink_env_get(env)(n))
    #Lam: λ&body. @pink_lift(#Clo{env, body})
    #LamR: λ&body. @pink_lift(#CloR{env, body})
    #App: λ&f. λ&x.
      %vf = @pink_evalc(env)(f);
      %vx = @pink_evalc(env)(x);
      @pink_apply(vf)(vx)
    #Let: λ&val. λ&body.
      %vv = @pink_evalc(env)(val);
      @pink_evalc(#CON{vv, env})(body)
    #Mov: λ&val. λ&body.
      %vv = @pink_evalc(env)(val);
      @pink_evalc(#CON{vv, env})(body)
    #If: λ&c. λ&t. λ&e.
      %vc = @pink_evalc(env)(c);
      λ{
        #Cst: λ&n. λ{0: @pink_evalc(env)(e); λ&m. @pink_evalc(env)(t)}(n)
        #Cod: λ&cc.
          %vt = @pink_evalc(env)(t);
          %ve = @pink_evalc(env)(e);
          λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
        _ : @pink_err(#if)
      }(vc)
    #Lft: λ&e.
      %v = @pink_evalc(env)(e);
      @pink_lift(v)
    #Run: λ&b. λ&e.
      %vb = @pink_evalc(env)(b);
      λ{
        #Cod: λ&bc.
          %vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
        _ : λ&u.
          %vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. @pink_evalc(env)(ec); _ : @pink_err(#run)}(vc)
      }(vb)
    #Cod: λ&e. #Cod{e}
    #Add: λ&a. λ&b.
      %va = @pink_evalc(env)(a);
      %vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na + nb)}); _ : @pink_err(#add)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
        _ : @pink_err(#add)
      }(va)
    #Sub: λ&a. λ&b.
      %va = @pink_evalc(env)(a);
      %vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na - nb)}); _ : @pink_err(#sub)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
        _ : @pink_err(#sub)
      }(va)
    #Mul: λ&a. λ&b.
      %va = @pink_evalc(env)(a);
      %vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na * nb)}); _ : @pink_err(#mul)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
        _ : @pink_err(#mul)
      }(va)
    #Eql: λ&a. λ&b.
      %va = @pink_evalc(env)(a);
      %vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na == nb)}); _ : @pink_err(#eql)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
        _ : @pink_err(#eql)
      }(va)
    #CON: λ&a. λ&b.
      %va = @pink_evalc(env)(a);
      %vb = @pink_evalc(env)(b);
      λ{
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
        _ : λ&u. @pink_lift(#CON{va, vb})
      }(va)
    #NIL: @pink_lift(#NIL)
    #CHR: λ&c. @pink_lift(#CHR{c})
    #Fst: λ&p.
      %vp = @pink_evalc(env)(p);
      λ{
        #CON: λ&a. λ&b. a
        #Cod: λ&pc. #Cod{#Fst{pc}}
        _ : @pink_err(#fst)
      }(vp)
    #Snd: λ&p.
      %vp = @pink_evalc(env)(p);
      λ{
        #CON: λ&a. λ&b. b
        #Cod: λ&pc. #Cod{#Snd{pc}}
        _ : @pink_err(#snd)
      }(vp)
    _ : @pink_err(#exp)
  }(exp)

@pink_unwrap = λ&v.
  λ{
    #Cst: λ&n. n
    #Sym: λ&s. #Sym{s}
    #CHR: λ&c. #CHR{c}
    #CON: λ&a. λ&b. #CON{@pink_unwrap(a), @pink_unwrap(b)}
    #NIL: #NIL
    #Cod: λ&e. #Cod{e}
    #Clo: λ&env. λ&body. #Clo{env, body}
    #CloR: λ&env. λ&body. #CloR{env, body}
    _ : @pink_err(#unw)
  }(v)

// =============================================================================
// Purple Runtime Extensions
// =============================================================================

// Meta-environment: #MEnv{env, handlers, parent, level}
// - env: variable bindings (same as Pink)
// - handlers: #HTab{...} of eval handlers
// - parent: parent meta-environment (lazy, #NIL if not yet created)

@purple_menv_env = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. e; _ : @pink_err(#menv)}(m)
@purple_menv_handlers = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. h; _ : @pink_err(#menv)}(m)
@purple_menv_parent = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. p; _ : @pink_err(#menv)}(m)
@purple_menv_level = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. l; _ : @pink_err(#menv)}(m)

// Create new meta-environment with default handlers and level - curried
@purple_menv_new = λl. λp. λe.
  %level = l; %parent = p; %env = e;
  #MEnv{env, @purple_default_handlers, parent, level}

// Ensure parent meta-environment exists (lazy creation at level+1)
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_ensure_parent = λ&menv.
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #NIL: @purple_menv_new((level + 1))(#NIL)(#NIL)
      _ : parent
    }(parent)
  ; _ : @pink_err(#menv)}(menv)

// Go up one level and return the parent menv
@purple_go_up = λ&menv. @purple_ensure_parent(menv)

// Shift n levels up the tower and evaluate expression
// Uses explicit case matching for small n values
@purple_shift_levels = λm. λevf. λnv. λex.
  %menv = m; %eval_fn = evf; %n = nv; %e = ex;
  λ{
    0: eval_fn(menv)(e)
    1:
      %m1 = @purple_go_up(menv);
      eval_fn(m1)(e)
    2:
      %m1 = @purple_go_up(menv);
      %m2 = @purple_go_up(m1);
      eval_fn(m2)(e)
    3:
      %m1 = @purple_go_up(menv);
      %m2 = @purple_go_up(m1);
      %m3 = @purple_go_up(m2);
      eval_fn(m3)(e)
    _ : @pink_err(#shft)
  }(n)

// Update menv with new env (preserves handlers and parent)
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_menv_with_env = λ&menv. λ&new_env.
  λ{#MEnv: λ&e. λ&h. λ&p. λ&l. #MEnv{new_env, h, p, l}
  ; _ : @pink_err(#menv)}(menv)

// Purple application helper
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_apply = λ&menv. λ&self. λ&vf. λ&vx.
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #Clo: λ&cenv. λ&body.
        self(#MEnv{#CON{vx, cenv}, handlers, parent, level})(body)
      #CloR: λ&cenv. λ&body.
        self(#MEnv{#CON{vx, #CON{vf, cenv}}, handlers, parent, level})(body)
      #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
      _ : @pink_err(#app)
    }(vf)
  ; _ : @pink_err(#menv)}(menv)

// Helper: extract first element of a constructor
@purple_get1 = λ&exp. λ{#CON: λ&x. x; #NIL: @pink_err(#get)}(exp)
@purple_get2a = λ&exp. λ{#CON: λ&x. λ&y. x; #NIL: @pink_err(#get)}(exp)
@purple_get2b = λ&exp. λ{#CON: λ&x. λ&y. y; #NIL: @pink_err(#get)}(exp)
@purple_get3a = λ&exp. λ{#CON: λ&x. λ&y. λ&z. x; #NIL: @pink_err(#get)}(exp)
@purple_get3b = λ&exp. λ{#CON: λ&x. λ&y. λ&z. y; #NIL: @pink_err(#get)}(exp)
@purple_get3c = λ&exp. λ{#CON: λ&x. λ&y. λ&z. z; #NIL: @pink_err(#get)}(exp)

// Default handler implementations
// Handlers wrapped in #HFn for tagged dispatch
// Lit handler receives #Cst{n}, returns a value
@purple_h_lit = #HFn{λ&v. v}

// Var handler receives #CON{#Cst{idx}, env}, returns the value
// Default just does standard lookup
@purple_h_var = #HFn{λ&arg.
  λ{#CON: λ&idx. λ&env.
    λ{#Cst: λ&n. @pink_env_get(env)(n); _ : @pink_err(#var)}(idx)
  ; _ : @pink_err(#var)}(arg)}

@purple_h_lam = λ&menv. λ&self. λ&exp.
  λ{#Lam: λ&body.
    !!&env = @purple_menv_env(menv);
    #Clo{env, body}
  ; _ : @pink_err(#lam)}(exp)

// App handler receives #CON{vf, vx} (evaluated function and argument)
// Returns the result of application
// Note: This is a placeholder - actual application uses @purple_apply_menv
@purple_h_app = #HFn{λ&args.
  λ{#CON: λ&vf. λ&vx. @purple_apply_simple(vf)(vx); _ : @pink_err(#happ)}(args)}

// Simple application using purple_eval with fresh menv
// Used by app handler (which doesn't have menv context)
@purple_apply_simple = λf. λx.
  %vf = f; %vx = x;
  λ{
    #Clo: λ&cenv. λ&body.
      @purple_eval(@purple_menv_new(0)(#NIL)(#CON{vx, cenv}))(body)
    #CloR: λ&cenv. λ&body.
      @purple_eval(@purple_menv_new(0)(#NIL)(#CON{vx, #CON{vf, cenv}}))(body)
    #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
    _ : @pink_err(#app)
  }(vf)

// Default application (for pink compatibility) - curried
@purple_apply_default = λf. λx. @purple_apply_simple(f)(x)

// If handler receives #Cst{n} (evaluated condition), returns #Cst{truth_value}
// truth_value: 0 = false (take else branch), non-0 = true (take then branch)
// Default behavior: pass through unchanged (0 is false, non-0 is true)
@purple_h_if = #HFn{λ&v. v}

@purple_h_lft = λ&menv. λ&self. λ&exp.
  λ{#Lft: λ&e.
    !!&v = self(menv)(e);
    @pink_lift(v)
  ; _ : @pink_err(#lft)}(exp)

@purple_h_run = λ&menv. λ&self. λ&exp.
  λ{#Run: λ&b. λ&e.
    !!&vb = self(menv)(b);
    λ{
      #Cst: λ&n.
        !!&vc = @purple_evalc(menv)(e);
        λ{#Cod: λ&ec. self(menv)(ec); _ : @pink_err(#run)}(vc)
      #Cod: λ&bc.
        !!&vc = @purple_evalc(menv)(e);
        λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
      _ : @pink_err(#run)
    }(vb)
  ; _ : @pink_err(#run)}(exp)

// EM handler: execute at meta-level
@purple_h_em = λ&menv. λ&self. λ&exp.
  λ{#EM: λ&e.
    !!&parent = @purple_ensure_parent(menv);
    self(parent)(e)
  ; _ : @pink_err(#em)}(exp)

// clambda handler: compile under current semantics
@purple_h_clam = λ&menv. λ&self. λ&exp.
  λ{#CLam: λ&body.
    !!&compiled = @purple_evalc(menv)(#Lam{body});
    λ{#Cod: λ&code. self(menv)(code); _ : @pink_err(#clam)}(compiled)
  ; _ : @pink_err(#clam)}(exp)

// Default handler table
@purple_default_handlers = #HTab{
  @purple_h_lit,
  @purple_h_var,
  @purple_h_lam,
  @purple_h_app,
  @purple_h_if,
  @purple_h_lft,
  @purple_h_run,
  @purple_h_em,
  @purple_h_clam
}

// Handler table accessors (0-indexed) - curried for MOV pattern
@purple_htab_get = λt. λi.
  %tab = t; %idx = i;
  λ{#HTab: λ&h0.λ&h1.λ&h2.λ&h3.λ&h4.λ&h5.λ&h6.λ&h7.λ&h8.
    λ{0: h0; 1: h1; 2: h2; 3: h3; 4: h4; 5: h5; 6: h6; 7: h7; 8: h8; _ : @pink_err(#hidx)}(idx)
  ; _ : @pink_err(#htab)}(tab)

// Symbol to handler index mapping
// Maps handler name symbols to indices: lit=0, var=1, lam=2, app=3, if=4, lft=5, run=6, em=7, clam=8
@purple_sym_to_idx = λ&sym.
  λ{
    #lit: 0
    #var: 1
    #lam: 2
    #app: 3
    #if: 4
    #lft: 5
    #run: 6
    #em: 7
    #clam: 8
    _ : @pink_err(#symi)
  }(sym)

// Get handler by symbol name - curried
@purple_htab_get_by_sym = λt. λs.
  %tab = t; %sym = s;
  %idx = @purple_sym_to_idx(sym);
  @purple_htab_get(tab)(idx)

// Set handler by symbol name (returns new htab) - curried
@purple_htab_set_by_sym = λt. λs. λh.
  %tab = t; %sym = s; %handler = h;
  %idx = @purple_sym_to_idx(sym);
  λ{#HTab: λ&h0.λ&h1.λ&h2.λ&h3.λ&h4.λ&h5.λ&h6.λ&h7.λ&h8.
    λ{
      0: #HTab{handler, h1, h2, h3, h4, h5, h6, h7, h8}
      1: #HTab{h0, handler, h2, h3, h4, h5, h6, h7, h8}
      2: #HTab{h0, h1, handler, h3, h4, h5, h6, h7, h8}
      3: #HTab{h0, h1, h2, handler, h4, h5, h6, h7, h8}
      4: #HTab{h0, h1, h2, h3, handler, h5, h6, h7, h8}
      5: #HTab{h0, h1, h2, h3, h4, handler, h6, h7, h8}
      6: #HTab{h0, h1, h2, h3, h4, h5, handler, h7, h8}
      7: #HTab{h0, h1, h2, h3, h4, h5, h6, handler, h8}
      8: #HTab{h0, h1, h2, h3, h4, h5, h6, h7, handler}
      _ : @pink_err(#hset)
    }(idx)
  ; _ : @pink_err(#htab)}(tab)

// Get handler from symbol (helper for GMta) - curried
@purple_get_handler = λh. λk.
  %handlers = h; %key = k;
  λ{#Sym: λ&s. @purple_htab_get_by_sym(handlers)(s); _ : @pink_err(#gmta)}(key)

// Set handler and return new menv (helper for SMta) - curried
// Automatically wraps closures for handler dispatch
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_set_handler = λm. λk. λv.
  %menv = m; %key = k; %val = v;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{#Sym: λ&s.
      %wrapped = @purple_wrap_handler(val);
      %new_handlers = @purple_htab_set_by_sym(handlers)(s)(wrapped);
      #MEnv{env, new_handlers, parent, level}
    ; _ : @pink_err(#smta)}(key)
  ; _ : @pink_err(#menv)}(menv)

// Call a handler with one argument - curried
// Uses tagged handlers: #HFn{fn} for HVM4 functions, #HClo{e,b} for Purple closures
// IMPORTANT: Handler bodies evaluate with DEFAULT handlers to avoid infinite recursion
// when the handler body contains the same form type it's handling
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_call1 = λm. λef. λh. λa.
  %menv = m; %eval_fn = ef; %handler = h; %arg = a;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #HFn: λ&f. f(arg)
      #HClo: λ&e. λ&b. eval_fn(#MEnv{#CON{arg, e}, @purple_default_handlers, parent, level})(b)
      _ : @pink_err(#h1)
    }(handler)
  ; _ : @pink_err(#menv)}(menv)

// Wrap a Purple closure for use as a handler
@purple_wrap_handler = λ&clo.
  λ{#Clo: λ&e. λ&b. #HClo{e, b}; _ : @pink_err(#wh)}(clo)

// Constructor argument extraction - curried
// For runtime introspection of AST nodes
@purple_ctr_arg = λc. λi.
  %ctr = c; %idx = i;
  λ{
    #Cst: λ&n.
      // Extract from constructor by index
      λ{
        #Lit: λ&a. λ{0: #Cst{a}; _ : @pink_err(#carg)}(n)
        #Sym: λ&a. λ{0: #Sym{a}; _ : @pink_err(#carg)}(n)
        #Var: λ&a. λ{0: #Cst{a}; _ : @pink_err(#carg)}(n)
        #Lam: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #LamR: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #App: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Let: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #If: λ&a. λ&b. λ&c. λ{0: a; 1: b; 2: c; _ : @pink_err(#carg)}(n)
        #Add: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Sub: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Mul: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Eql: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #CHR: λ&c. λ{0: c; _ : @pink_err(#carg)}(n)
        #CON: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #NIL: @pink_err(#carg)
        #Lft: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #Run: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Cod: λ&a. λ{0: #Cod{a}; _ : @pink_err(#carg)}(n)
        #Fst: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #Snd: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #EM: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #CLam: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        _ : @pink_err(#carg)
      }(ctr)
    #Cod: λ&ic. λ{#Cod: λ&cc. #Cod{#CArg{cc, ic}}; _ : @pink_err(#carg)}(ctr)
    _ : @pink_err(#carg)
  }(idx)

// Constructor tag extraction - returns the constructor name as a symbol
// Nick encoding: '_'=0, 'a'-'z'=1-26, 'A'-'Z'=27-52, '0'-'9'=53-62, '$'=63
@purple_ctr_tag = λ&ctr.
  λ{
    #Lit: λ&a. #Sym{156244}
    #Sym: λ&a. #Sym{185933}
    #Var: λ&a. #Sym{196690}
    #Lam: λ&a. #Sym{155725}
    #LamR: λ&a. #Sym{9966444}
    #App: λ&a. λ&b. #Sym{111632}
    #Let: λ&a. λ&b. #Sym{155988}
    #If: λ&a. λ&b. λ&c. #Sym{2246}
    #Add: λ&a. λ&b. #Sym{110852}
    #Sub: λ&a. λ&b. #Sym{185666}
    #Mul: λ&a. λ&b. #Sym{161100}
    #Eql: λ&a. λ&b. #Sym{128076}
    #CHR: λ&a. #Sym{121004}
    #CON: λ&a. λ&b. #Sym{121448}
    #NIL: #Sym{166118}
    #Lft: λ&a. #Sym{156052}
    #Run: λ&a. λ&b. #Sym{181582}
    #Cod: λ&a. #Sym{119748}
    #Fst: λ&a. #Sym{132308}
    #Snd: λ&a. #Sym{185220}
    #EM: λ&a. #Sym{2023}
    #CLam: λ&a. #Sym{7757901}
    #Cst: λ&a. #Sym{120020}
    #Clo: λ&a. λ&b. #Sym{119567}
    #CloR: λ&a. λ&b. #Sym{7652332}
    _ : @pink_err(#ctag)
  }(ctr)

// Purple application (uses menv)
@purple_apply_menv = λ&menv. λ&self. λ&vf. λ&vx.
  λ{
    #Clo: λ&cenv. λ&body.
      !!&new_menv = @purple_menv_with_env(menv)(#CON{vx, cenv});
      self(new_menv)(body)
    #CloR: λ&cenv. λ&body.
      !!&new_menv = @purple_menv_with_env(menv)(#CON{vx, #CON{vf, cenv}});
      self(new_menv)(body)
    #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
    _ : @pink_err(#app)
  }(vf)

// =============================================================================
// Pattern Matching Support
// =============================================================================

// Check if a value matches a pattern - curried
// Returns #CON{matched?, bindings_list} where bindings_list is values to bind
// For quoted expressions (#Cod), unwraps and matches against inner value
@purple_pattern_match = λv. λp.
  %val = v; %pattern = p;
  λ{
    // Wildcard matches anything, no bindings
    #PWld: #CON{1, #NIL}

    // Variable pattern matches anything, binds the value
    #PVar: λ&name. #CON{1, #CON{val, #NIL}}

    // Literal pattern matches if value equals literal
    // Uses helper to handle #Cod unwrapping (can't reuse pattern after matching)
    #PLit: λ&n. @purple_match_lit(val)(n)

    // Constructor pattern matches if value has same tag
    // Uses helper to handle #Cod unwrapping (can't reuse pattern after matching)
    #PCtr: λ&tag. λ&arg_names. @purple_match_ctr(val)(tag)(arg_names)

    _ : #CON{0, #NIL}
  }(pattern)

// Helper for literal pattern matching with #Cod unwrapping - curried
@purple_match_lit = λv. λn.
  %val = v; %lit = n;
  λ{
    #Cst: λ&v. #CON{(v == lit), #NIL}
    #Cod: λ&inner. @purple_match_lit(inner)(lit)
    _ : #CON{0, #NIL}
  }(val)

// Match a constructor pattern against a value - curried
// tag is the nick-encoded constructor name
// arg_names is a list of name IDs (ignored, we just need count)
// Handles #Cod unwrapping for quoted expressions
// NOTE: Can't use val in default case (HVM4 limitation), so handle each constructor explicitly
@purple_match_ctr = λv. λt. λa.
  %val = v; %tag = t; %arg_names = a;
  λ{
    #Cod: λ&inner. @purple_match_ctr(inner)(tag)(arg_names)
    #Lit: λ&a. @purple_match_tag_extract(156244)(tag)(#CON{#Cst{a}, #NIL})(arg_names)
    #Sym: λ&a. @purple_match_tag_extract(185933)(tag)(#CON{#Sym{a}, #NIL})(arg_names)
    #Var: λ&a. @purple_match_tag_extract(196690)(tag)(#CON{#Cst{a}, #NIL})(arg_names)
    #Lam: λ&a. @purple_match_tag_extract(155725)(tag)(#CON{a, #NIL})(arg_names)
    #LamR: λ&a. @purple_match_tag_extract(9966444)(tag)(#CON{a, #NIL})(arg_names)
    #App: λ&a. λ&b. @purple_match_tag_extract(111632)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #Let: λ&a. λ&b. @purple_match_tag_extract(155988)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #If: λ&a. λ&b. λ&c. @purple_match_tag_extract(2246)(tag)(#CON{a, #CON{b, #CON{c, #NIL}}})(arg_names)
    #Add: λ&a. λ&b. @purple_match_tag_extract(110852)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #Sub: λ&a. λ&b. @purple_match_tag_extract(185666)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #Mul: λ&a. λ&b. @purple_match_tag_extract(161100)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #Eql: λ&a. λ&b. @purple_match_tag_extract(128076)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #CHR: λ&c. @purple_match_tag_extract(121004)(tag)(#CON{#Cst{c}, #NIL})(arg_names)
    #CON: λ&a. λ&b. @purple_match_tag_extract(121448)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #NIL: @purple_match_tag_extract(166118)(tag)(#NIL)(arg_names)
    #Lft: λ&a. @purple_match_tag_extract(156052)(tag)(#CON{a, #NIL})(arg_names)
    #Run: λ&a. λ&b. @purple_match_tag_extract(181582)(tag)(#CON{a, #CON{b, #NIL}})(arg_names)
    #Fst: λ&a. @purple_match_tag_extract(132308)(tag)(#CON{a, #NIL})(arg_names)
    #Snd: λ&a. @purple_match_tag_extract(185220)(tag)(#CON{a, #NIL})(arg_names)
    #EM: λ&a. @purple_match_tag_extract(2023)(tag)(#CON{a, #NIL})(arg_names)
    #CLam: λ&a. @purple_match_tag_extract(7757901)(tag)(#CON{a, #NIL})(arg_names)
    #Cst: λ&a. @purple_match_tag_extract(120020)(tag)(#CON{#Cst{a}, #NIL})(arg_names)
    #Clo: λ&e. λ&b. @purple_match_tag_extract(119567)(tag)(#CON{e, #CON{b, #NIL}})(arg_names)
    #CloR: λ&e. λ&b. @purple_match_tag_extract(7652332)(tag)(#CON{e, #CON{b, #NIL}})(arg_names)
    _ : #CON{0, #NIL}  // Unknown constructor - no match
  }(val)

// Compare tags and return extracted args if match - curried
@purple_match_tag_extract = λvt. λpt. λea. λan.
  %val_tag = vt; %pattern_tag = pt; %extracted_args = ea; %arg_names = an;
  λ{
    0: #CON{0, #NIL}  // Tags don't match
    _ : λ&u. #CON{1, extracted_args}  // Tags match, return the args
  }((val_tag == pattern_tag))

// Try each case until one matches (legacy - now compiled to native HVM4 match) - curried
// Returns the result of the matching case's body
// NOTE: Pattern matching is now compiled to native HVM4 at compile-time
// This function is kept for backward compatibility with dynamic match expressions
@purple_try_cases = λm. λef. λv. λc.
  %menv = m; %eval_fn = ef; %val = v; %cases = c;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    @purple_try_cases_inner(env)(handlers)(parent)(level)(eval_fn)(val)(cases)
  ; _ : @pink_err(#menv)}(menv)

@purple_try_cases_inner = λe. λh. λp. λl. λef. λv. λc.
  %env = e; %handlers = h; %parent = p; %level = l; %eval_fn = ef; %val = v; %cases = c;
  λ{
    #NIL: @pink_err(#nmch)  // No case matched
    #CON: λ&case. λ&rest.
      λ{
        #Case: λ&pattern. λ&body.
          %match_result = @purple_pattern_match(val)(pattern);
          λ{
            #CON: λ&matched. λ&bindings.
              λ{
                0: @purple_try_cases_inner(env)(handlers)(parent)(level)(eval_fn)(val)(rest)  // Try next case
                λ&u.
                  // Match! Bind variables and evaluate body
                  %new_env = @purple_bind_all(env)(bindings);
                  eval_fn(#MEnv{new_env, handlers, parent, level})(body)
              }(matched)
            _ : @pink_err(#mat)
          }(match_result)
        _ : @pink_err(#case)
      }(case)
    _ : @pink_err(#cases)
  }(cases)

// Bind a list of values to environment - curried
// Bindings list is in order [first, second, ...]
// We need first binding at index 0 (head of env)
// So we prepend in reverse order: bind last first, then second-to-last, etc.
@purple_bind_all = λe. λb.
  %env = e; %bindings = b;
  @purple_bind_fold(env)(bindings)

// Prepend bindings in order - first binding ends up deepest - curried
// Then we need to reverse the final env...
// Actually simpler: just use this and adjust de Bruijn indices in pattern matching
@purple_bind_fold = λe. λb.
  %env = e; %bindings = b;
  λ{
    #NIL: env
    #CON: λ&val.λ&rest. @purple_bind_fold(#CON{val, env})(rest)
    _ : env
  }(bindings)

// Evaluate a list of expressions and return evaluated list - curried
@purple_eval_list = λm. λef. λl.
  %menv = m; %eval_fn = ef; %lst = l;
  λ{
    #NIL: #NIL
    #CON: λ&head. λ&tail.
      %vh = eval_fn(menv)(head);
      %vt = @purple_eval_list(menv)(eval_fn)(tail);
      #CON{vh, vt}
    _ : #NIL
  }(lst)

// Continue after evaluating first expression in do block - curried
// If vf is an FFI marker, chain it (FFI results need special handling)
// Otherwise, just continue evaluating rest
@purple_do_continue = λm. λef. λf. λr.
  %menv = m; %eval_fn = ef; %vf = f; %rest = r;
  λ{
    // If first result is FFI, we need to chain: #Do{#FFI{...}, rest}
    // This allows the C driver to execute FFI calls in sequence
    #FFI: λ&name. λ&args. #Do{#FFI{name, args}, rest}
    // For non-FFI values, just discard and continue
    _ : λ&u. eval_fn(menv)(rest)
  }(vf)

// Purple evaluator - uses MOV for efficient bindings, direct @-recursion
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_eval = λm. λexp.
  %menv = m;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #Lit: λ&n.
        %h = @purple_htab_get(handlers)(0);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#Cst{n})
      #Sym: λ&s. #Sym{s}
      #Var: λ&n.
        %h = @purple_htab_get(handlers)(1);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#CON{#Cst{n}, env})
      #Lam: λ&body. #Clo{env, body}
      #LamR: λ&body. #CloR{env, body}
      #App: λ&f. λ&x.
        %vf = @purple_eval(#MEnv{env, handlers, parent, level})(f);
        %vx = @purple_eval(#MEnv{env, handlers, parent, level})(x);
        // Call app handler with evaluated function and argument
        %h = @purple_htab_get(handlers)(3);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#CON{vf, vx})
      #Let: λ&val. λ&body.
        %vv = @purple_eval(#MEnv{env, handlers, parent, level})(val);
        @purple_eval(#MEnv{#CON{vv, env}, handlers, parent, level})(body)
      #Mov: λ&val. λ&body.
        %vv = @purple_eval(#MEnv{env, handlers, parent, level})(val);
        @purple_eval(#MEnv{#CON{vv, env}, handlers, parent, level})(body)
      #If: λ&c. λ&t. λ&e.
        %vc = @purple_eval(#MEnv{env, handlers, parent, level})(c);
        λ{
          #Cst: λ&n.
            // Call if handler to interpret the condition
            %h = @purple_htab_get(handlers)(4);
            %truth = @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#Cst{n});
            λ{#Cst: λ&tv. λ{0: @purple_eval(#MEnv{env, handlers, parent, level})(e); λ&m. @purple_eval(#MEnv{env, handlers, parent, level})(t)}(tv); _ : @pink_err(#if)}(truth)
          #Cod: λ&cc.
            %vt = @purple_evalc(#MEnv{env, handlers, parent, level})(t);
            %ve = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
          _ : @pink_err(#if)
        }(vc)
      #Lft: λ&e.
        %v = @purple_eval(#MEnv{env, handlers, parent, level})(e);
        @pink_lift(v)
      #Run: λ&b. λ&e.
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cod: λ&bc.
            %vc = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
          _ : λ&u.
            %vc = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&ec. @purple_eval(#MEnv{env, handlers, parent, level})(ec); _ : @pink_err(#run)}(vc)
        }(vb)
      #Cod: λ&e. #Cod{e}
      #Add: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na + nb)}; _ : @pink_err(#add)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
          _ : @pink_err(#add)
        }(va)
      #Sub: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na - nb)}; _ : @pink_err(#sub)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
          _ : @pink_err(#sub)
        }(va)
      #Mul: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na * nb)}; _ : @pink_err(#mul)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
          _ : @pink_err(#mul)
        }(va)
      #Eql: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na == nb)}; _ : @pink_err(#eql)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
          _ : @pink_err(#eql)
        }(va)
      #Lt: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na < nb)}; _ : @pink_err(#lt)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Lt{ca, cb}}; _ : @pink_err(#lt)}(vb)
          _ : @pink_err(#lt)
        }(va)
      #Gt: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na > nb)}; _ : @pink_err(#gt)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Gt{ca, cb}}; _ : @pink_err(#gt)}(vb)
          _ : @pink_err(#gt)
        }(va)
      #Le: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na <= nb)}; _ : @pink_err(#le)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Le{ca, cb}}; _ : @pink_err(#le)}(vb)
          _ : @pink_err(#le)
        }(va)
      #Ge: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na >= nb)}; _ : @pink_err(#ge)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Ge{ca, cb}}; _ : @pink_err(#ge)}(vb)
          _ : @pink_err(#ge)
        }(va)
      #Div: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na / nb)}; _ : @pink_err(#div)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Div{ca, cb}}; _ : @pink_err(#div)}(vb)
          _ : @pink_err(#div)
        }(va)
      #Mod: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na % nb)}; _ : @pink_err(#mod)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mod{ca, cb}}; _ : @pink_err(#mod)}(vb)
          _ : @pink_err(#mod)
        }(va)
      #And: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: #Cst{0}; λ&m. @purple_eval(#MEnv{env, handlers, parent, level})(b)}(na)
          #Cod: λ&ca.
            %vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
            λ{#Cod: λ&cb. #Cod{#And{ca, cb}}; _ : @pink_err(#and)}(vb)
          _ : @pink_err(#and)
        }(va)
      #Or: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: @purple_eval(#MEnv{env, handlers, parent, level})(b); λ&m. #Cst{1}}(na)
          #Cod: λ&ca.
            %vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
            λ{#Cod: λ&cb. #Cod{#Or{ca, cb}}; _ : @pink_err(#or)}(vb)
          _ : @pink_err(#or)
        }(va)
      #Not: λ&a.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: #Cst{1}; λ&m. #Cst{0}}(na)
          #Cod: λ&ca. #Cod{#Not{ca}}
          _ : @pink_err(#not)
        }(va)
      #CON: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
          _ : λ&u. #CON{va, vb}
        }(va)
      #NIL: #NIL
      #CHR: λ&c. #CHR{c}
      #Fst: λ&p.
        %vp = @purple_eval(#MEnv{env, handlers, parent, level})(p);
        λ{
          #CON: λ&a. λ&b. a
          #Cod: λ&pc. #Cod{#Fst{pc}}
          _ : @pink_err(#fst)
        }(vp)
      #Snd: λ&p.
        %vp = @purple_eval(#MEnv{env, handlers, parent, level})(p);
        λ{
          #CON: λ&a. λ&b. b
          #Cod: λ&pc. #Cod{#Snd{pc}}
          _ : @pink_err(#snd)
        }(vp)
      #EM: λ&e.
        %new_parent = @purple_ensure_parent(#MEnv{env, handlers, parent, level});
        @purple_eval(new_parent)(e)
      #CLam: λ&body.
        %compiled = @purple_evalc(#MEnv{env, handlers, parent, level})(#Lam{body});
        λ{#Cod: λ&code. @purple_eval(#MEnv{env, handlers, parent, level})(code); _ : @pink_err(#clam)}(compiled)
      #GMta: λ&key.
        %vk = @purple_eval(#MEnv{env, handlers, parent, level})(key);
        @purple_get_handler(handlers)(vk)
      #SMta: λ&key. λ&val.
        %vk = @purple_eval(#MEnv{env, handlers, parent, level})(key);
        %vv = @purple_eval(#MEnv{env, handlers, parent, level})(val);
        @purple_set_handler(#MEnv{env, handlers, parent, level})(vk)(vv)
      #SEq: λ&a. λ&b.
        %va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        %vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Sym: λ&sa. λ{#Sym: λ&sb. #Cst{(sa == sb)}; _ : @pink_err(#seq)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#SEq{ca, cb}}; _ : @pink_err(#seq)}(vb)
          _ : @pink_err(#seq)
        }(va)
      #WMnv: λ&m. λ&body.
        %new_menv = @purple_eval(#MEnv{env, handlers, parent, level})(m);
        λ{#MEnv: λ&e. λ&h. λ&p. λ&l. @purple_eval(new_menv)(body); _ : @pink_err(#wmenv)}(new_menv)
      #CArg: λ&c. λ&i.
        %vc = @purple_eval(#MEnv{env, handlers, parent, level})(c);
        %vi = @purple_eval(#MEnv{env, handlers, parent, level})(i);
        @purple_ctr_arg(vc)(vi)
      #CTag: λ&e.
        %ve = @purple_eval(#MEnv{env, handlers, parent, level})(e);
        @purple_ctr_tag(ve)
      #Eval: λ&e.
        %ve = @purple_eval(#MEnv{env, handlers, parent, level})(e);
        λ{#Cod: λ&code. @purple_eval(#MEnv{env, handlers, parent, level})(code); _ : @pink_err(#eval)}(ve)
      #MLvl: #Cst{level}
      #Shft: λ&n. λ&e.
        %vn = @purple_eval(#MEnv{env, handlers, parent, level})(n);
        λ{#Cst: λ&cnt. @purple_shift_levels(#MEnv{env, handlers, parent, level})(@purple_eval)(cnt)(e); _ : @pink_err(#shft)}(vn)
      #Mat: λ&expr. λ&cases.
        %val = @purple_eval(#MEnv{env, handlers, parent, level})(expr);
        @purple_try_cases(#MEnv{env, handlers, parent, level})(@purple_eval)(val)(cases)
      // Native match: scrutinee is evaluated, then native HVM4 pattern matching applied
      // The matcher returns #CON{body, bindings_list} where bindings need to be added to env
      // This is only used for simple patterns without wildcards + args (see compiler check)
      #NMat: λ&scrutinee. λ&matcher.
        %val = @purple_eval(#MEnv{env, handlers, parent, level})(scrutinee);
        %result = matcher(val);
