// Purple runtime (extends Pink with reflection)
// Implements the conceptually infinite tower from "Collapsing Towers"

// =============================================================================
// Pink Base Runtime (copied for self-containment)
// =============================================================================

// Error constructor with symbol payload
@pink_err = λ&msg. #Err{msg}

// =============================================================================
// Fixed-Point Arithmetic Helpers (uses parallel integer ops)
// =============================================================================

// Add two fixed-point numbers (assumes same scale for now)
// #Fix{hi1, lo1, s} + #Fix{hi2, lo2, s} = #Fix{hi1+hi2+carry, lo1+lo2, s}
// Simplified: for values < 2^32, we only use lo
@fix_add = λa. λb.
  λ{#Fix: λ&h1. λ&l1. λ&s1.
    λ{#Fix: λ&h2. λ&l2. λ&s2.
      #Fix{(h1 + h2), (l1 + l2), s1}
    ; _ : @pink_err(#fxad)}(b)
  ; _ : @pink_err(#fxad)}(a)

// Subtract two fixed-point numbers (assumes same scale)
@fix_sub = λa. λb.
  λ{#Fix: λ&h1. λ&l1. λ&s1.
    λ{#Fix: λ&h2. λ&l2. λ&s2.
      #Fix{(h1 - h2), (l1 - l2), s1}
    ; _ : @pink_err(#fxsb)}(b)
  ; _ : @pink_err(#fxsb)}(a)

// Multiply two fixed-point numbers
// #Fix{0, v1, s1} * #Fix{0, v2, s2} = #Fix{0, v1*v2, s1+s2}
@fix_mul = λa. λb.
  λ{#Fix: λ&h1. λ&l1. λ&s1.
    λ{#Fix: λ&h2. λ&l2. λ&s2.
      #Fix{0, (l1 * l2), (s1 + s2)}
    ; _ : @pink_err(#fxmu)}(b)
  ; _ : @pink_err(#fxmu)}(a)

// Divide two fixed-point numbers
// #Fix{0, v1, s1} / #Fix{0, v2, s2} = #Fix{0, v1/v2, s1-s2}
@fix_div = λa. λb.
  λ{#Fix: λ&h1. λ&l1. λ&s1.
    λ{#Fix: λ&h2. λ&l2. λ&s2.
      #Fix{0, (l1 / l2), (s1 - s2)}
    ; _ : @pink_err(#fxdv)}(b)
  ; _ : @pink_err(#fxdv)}(a)

// Compare fixed-point with integer (for conditionals)
// Returns 1 if non-zero, 0 if zero
@fix_to_bool = λa.
  λ{#Fix: λ&h. λ&l. λ&s.
    λ{0: λ{0: 0; _ : 1}(l); _ : 1}(h)
  ; _ : @pink_err(#fxbl)}(a)

@pink_env_head = λe. !!&env = e; λ{#CON: λ&a. λ&b. a; #NIL: @pink_err(#env)}(env)
@pink_env_tail = λe. !!&env = e; λ{#CON: λ&a. λ&b. b; #NIL: @pink_err(#env)}(env)

@pink_env_get = λe. λi.
  %env = e; %idx = i;
  λ{0: @pink_env_head(env);
     λ&n. @pink_env_get(@pink_env_tail(env))(n - 1)}(idx)

@pink_reify = λv.
  λ{
    #Cst: λ&n. #Lit{n}
    #Fix: λ&hi. λ&lo. λ&scale. #Fix{hi, lo, scale}
    #Ptr: λ&hi. λ&lo. #Ptr{hi, lo}
    #Sym: λ&s. #Sym{s}
    #CHR: λ&c. #CHR{c}
    #CON: λ&a. λ&b. #CON{@pink_reify(a), @pink_reify(b)}
    #NIL: #NIL
    #Cod: λ&e. #Cod{e}
    #Clo: λ&env. λ&body.
      %cv = @pink_evalc(#CON{#Cod{#Var{0}}, env})(body);
      λ{#Cod: λ&code. #Lam{code}; _ : @pink_err(#rfy)}(cv)
    #CloR: λ&env. λ&body.
      %cv = @pink_evalc(#CON{#Cod{#Var{0}}, #CON{#Cod{#Var{1}}, env}})(body);
      λ{#Cod: λ&code. #LamR{code}; _ : @pink_err(#rfy)}(cv)
    _ : @pink_err(#rfy)
  }(v)

@pink_lift = λ&v.
  λ{
    #Cod: λ&code. #Cod{code}
    _ : λ&u. #Cod{@pink_reify(v)}
  }(v)

@pink_apply = λf. λx.
  !!&vf = f; !!&vx = x;
  λ{
    #Clo: λ&cenv. λ&body. @pink_eval(#CON{vx, cenv})(body)
    #CloR: λ&cenv. λ&body. @pink_eval(#CON{vx, #CON{vf, cenv}})(body)
    #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
    _ : @pink_err(#app)
  }(vf)

// Pink evaluator - uses MOV for efficient bindings, direct @-recursion
@pink_eval = λe. λexp.
  %env = e;
  λ{
    #Lit: λ&n. #Cst{n}
    #Fix: λ&hi. λ&lo. λ&scale. #Fix{hi, lo, scale}
    #Ptr: λ&hi. λ&lo. #Ptr{hi, lo}
    #Sym: λ&s. #Sym{s}
    #Var: λ&n. @pink_env_get(env)(n)
    #Lam: λ&body. #Clo{env, body}
    #LamR: λ&body. #CloR{env, body}
    #App: λ&f. λ&x.
      !!&vf = @pink_eval(env)(f);
      !!&vx = @pink_eval(env)(x);
      @pink_apply(vf)(vx)
    #Let: λ&val. λ&body.
      !!&vv = @pink_eval(env)(val);
      @pink_eval(#CON{vv, env})(body)
    #Mov: λ&val. λ&body.
      !!&vv = @pink_eval(env)(val);
      @pink_eval(#CON{vv, env})(body)
    #If: λ&c. λ&t. λ&e.
      !!&vc = @pink_eval(env)(c);
      λ{
        #Cst: λ&n. λ{0: @pink_eval(env)(e); λ&m. @pink_eval(env)(t)}(n)
        #Cod: λ&cc.
          !!&vt = @pink_evalc(env)(t);
          !!&ve = @pink_evalc(env)(e);
          λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
        _ : @pink_err(#if)
      }(vc)
    #Lft: λ&e.
      !!&v = @pink_eval(env)(e);
      @pink_lift(v)
    #Run: λ&b. λ&e.
      !!&vb = @pink_eval(env)(b);
      λ{
        #Cod: λ&bc.
          !!&vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
        _ : λ&u.
          !!&vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. @pink_eval(env)(ec); _ : @pink_err(#run)}(vc)
      }(vb)
    #Cod: λ&e. #Cod{e}
    #Add: λ&a. λ&b.
      !!&va = @pink_eval(env)(a);
      !!&vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na + nb)}; _ : @pink_err(#add)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
        _ : @pink_err(#add)
      }(va)
    #Sub: λ&a. λ&b.
      !!&va = @pink_eval(env)(a);
      !!&vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na - nb)}; _ : @pink_err(#sub)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
        _ : @pink_err(#sub)
      }(va)
    #Mul: λ&a. λ&b.
      !!&va = @pink_eval(env)(a);
      !!&vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na * nb)}; _ : @pink_err(#mul)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
        _ : @pink_err(#mul)
      }(va)
    #Eql: λ&a. λ&b.
      !!&va = @pink_eval(env)(a);
      !!&vb = @pink_eval(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na == nb)}; _ : @pink_err(#eql)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
        _ : @pink_err(#eql)
      }(va)
    #CON: λ&a. λ&b.
      !!&va = @pink_eval(env)(a);
      !!&vb = @pink_eval(env)(b);
      λ{
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
        _ : λ&u. #CON{va, vb}
      }(va)
    #NIL: #NIL
    #CHR: λ&c. #CHR{c}
    #Fst: λ&p.
      !!&vp = @pink_eval(env)(p);
      λ{
        #CON: λ&a. λ&b. a
        #Cod: λ&pc. #Cod{#Fst{pc}}
        _ : @pink_err(#fst)
      }(vp)
    #Snd: λ&p.
      !!&vp = @pink_eval(env)(p);
      λ{
        #CON: λ&a. λ&b. b
        #Cod: λ&pc. #Cod{#Snd{pc}}
        _ : @pink_err(#snd)
      }(vp)
    _ : @pink_err(#exp)
  }(exp)

// Pink compile-mode evaluator - lifts values to code
@pink_evalc = λe. λexp.
  %env = e;
  λ{
    #Lit: λ&n. @pink_lift(#Cst{n})
    #Fix: λ&hi. λ&lo. λ&scale. @pink_lift(#Fix{hi, lo, scale})
    #Ptr: λ&hi. λ&lo. @pink_lift(#Ptr{hi, lo})
    #Sym: λ&s. @pink_lift(#Sym{s})
    #Var: λ&n. @pink_lift(@pink_env_get(env)(n))
    #Lam: λ&body. @pink_lift(#Clo{env, body})
    #LamR: λ&body. @pink_lift(#CloR{env, body})
    #App: λ&f. λ&x.
      !!&vf = @pink_evalc(env)(f);
      !!&vx = @pink_evalc(env)(x);
      @pink_apply(vf)(vx)
    #Let: λ&val. λ&body.
      !!&vv = @pink_evalc(env)(val);
      @pink_evalc(#CON{vv, env})(body)
    #Mov: λ&val. λ&body.
      !!&vv = @pink_evalc(env)(val);
      @pink_evalc(#CON{vv, env})(body)
    #If: λ&c. λ&t. λ&e.
      !!&vc = @pink_evalc(env)(c);
      λ{
        #Cst: λ&n. λ{0: @pink_evalc(env)(e); λ&m. @pink_evalc(env)(t)}(n)
        #Cod: λ&cc.
          !!&vt = @pink_evalc(env)(t);
          !!&ve = @pink_evalc(env)(e);
          λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
        _ : @pink_err(#if)
      }(vc)
    #Lft: λ&e.
      !!&v = @pink_evalc(env)(e);
      @pink_lift(v)
    #Run: λ&b. λ&e.
      !!&vb = @pink_evalc(env)(b);
      λ{
        #Cod: λ&bc.
          !!&vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
        _ : λ&u.
          !!&vc = @pink_evalc(env)(e);
          λ{#Cod: λ&ec. @pink_evalc(env)(ec); _ : @pink_err(#run)}(vc)
      }(vb)
    #Cod: λ&e. #Cod{e}
    #Add: λ&a. λ&b.
      !!&va = @pink_evalc(env)(a);
      !!&vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na + nb)}); _ : @pink_err(#add)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
        _ : @pink_err(#add)
      }(va)
    #Sub: λ&a. λ&b.
      !!&va = @pink_evalc(env)(a);
      !!&vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na - nb)}); _ : @pink_err(#sub)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
        _ : @pink_err(#sub)
      }(va)
    #Mul: λ&a. λ&b.
      !!&va = @pink_evalc(env)(a);
      !!&vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na * nb)}); _ : @pink_err(#mul)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
        _ : @pink_err(#mul)
      }(va)
    #Eql: λ&a. λ&b.
      !!&va = @pink_evalc(env)(a);
      !!&vb = @pink_evalc(env)(b);
      λ{
        #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na == nb)}); _ : @pink_err(#eql)}(vb)
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
        _ : @pink_err(#eql)
      }(va)
    #CON: λ&a. λ&b.
      !!&va = @pink_evalc(env)(a);
      !!&vb = @pink_evalc(env)(b);
      λ{
        #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
        _ : λ&u. @pink_lift(#CON{va, vb})
      }(va)
    #NIL: @pink_lift(#NIL)
    #CHR: λ&c. @pink_lift(#CHR{c})
    #Fst: λ&p.
      !!&vp = @pink_evalc(env)(p);
      λ{
        #CON: λ&a. λ&b. a
        #Cod: λ&pc. #Cod{#Fst{pc}}
        _ : @pink_err(#fst)
      }(vp)
    #Snd: λ&p.
      !!&vp = @pink_evalc(env)(p);
      λ{
        #CON: λ&a. λ&b. b
        #Cod: λ&pc. #Cod{#Snd{pc}}
        _ : @pink_err(#snd)
      }(vp)
    _ : @pink_err(#exp)
  }(exp)

@pink_unwrap = λ&v.
  λ{
    #Cst: λ&n. n
    #Sym: λ&s. #Sym{s}
    #CHR: λ&c. #CHR{c}
    #CON: λ&a. λ&b. #CON{@pink_unwrap(a), @pink_unwrap(b)}
    #NIL: #NIL
    #Cod: λ&e. #Cod{e}
    #Clo: λ&env. λ&body. #Clo{env, body}
    #CloR: λ&env. λ&body. #CloR{env, body}
    _ : @pink_err(#unw)
  }(v)

// =============================================================================
// Purple Runtime Extensions
// =============================================================================

// Meta-environment: #MEnv{env, handlers, parent, level}
// - env: variable bindings (same as Pink)
// - handlers: #HTab{...} of eval handlers
// - parent: parent meta-environment (lazy, #NIL if not yet created)

@purple_menv_env = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. e; _ : @pink_err(#menv)}(m)
@purple_menv_handlers = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. h; _ : @pink_err(#menv)}(m)
@purple_menv_parent = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. p; _ : @pink_err(#menv)}(m)
@purple_menv_level = λ&m. λ{#MEnv: λ&e. λ&h. λ&p. λ&l. l; _ : @pink_err(#menv)}(m)

// Create new meta-environment with default handlers and level - curried
@purple_menv_new = λl. λp. λe.
  %level = l; %parent = p; %env = e;
  #MEnv{env, @purple_default_handlers, parent, level}

// Ensure parent meta-environment exists (lazy creation at level+1)
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_ensure_parent = λ&menv.
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #NIL: @purple_menv_new((level + 1))(#NIL)(#NIL)
      _ : parent
    }(parent)
  ; _ : @pink_err(#menv)}(menv)

// Go up one level and return the parent menv
@purple_go_up = λ&menv. @purple_ensure_parent(menv)

// Shift n levels up the tower and evaluate expression
// Uses explicit case matching for small n values
@purple_shift_levels = λm. λevf. λnv. λex.
  %menv = m; %eval_fn = evf; %n = nv; %e = ex;
  λ{
    0: eval_fn(menv)(e)
    1:
      %m1 = @purple_go_up(menv);
      eval_fn(m1)(e)
    2:
      %m1 = @purple_go_up(menv);
      %m2 = @purple_go_up(m1);
      eval_fn(m2)(e)
    3:
      %m1 = @purple_go_up(menv);
      %m2 = @purple_go_up(m1);
      %m3 = @purple_go_up(m2);
      eval_fn(m3)(e)
    _ : @pink_err(#shft)
  }(n)

// Update menv with new env (preserves handlers and parent)
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_menv_with_env = λ&menv. λ&new_env.
  λ{#MEnv: λ&e. λ&h. λ&p. λ&l. #MEnv{new_env, h, p, l}
  ; _ : @pink_err(#menv)}(menv)

// Purple application helper
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_apply = λ&menv. λ&self. λ&vf. λ&vx.
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #Clo: λ&cenv. λ&body.
        self(#MEnv{#CON{vx, cenv}, handlers, parent, level})(body)
      #CloR: λ&cenv. λ&body.
        self(#MEnv{#CON{vx, #CON{vf, cenv}}, handlers, parent, level})(body)
      #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
      _ : @pink_err(#app)
    }(vf)
  ; _ : @pink_err(#menv)}(menv)

// Helper: extract first element of a constructor
@purple_get1 = λ&exp. λ{#CON: λ&x. x; #NIL: @pink_err(#get)}(exp)
@purple_get2a = λ&exp. λ{#CON: λ&x. λ&y. x; #NIL: @pink_err(#get)}(exp)
@purple_get2b = λ&exp. λ{#CON: λ&x. λ&y. y; #NIL: @pink_err(#get)}(exp)
@purple_get3a = λ&exp. λ{#CON: λ&x. λ&y. λ&z. x; #NIL: @pink_err(#get)}(exp)
@purple_get3b = λ&exp. λ{#CON: λ&x. λ&y. λ&z. y; #NIL: @pink_err(#get)}(exp)
@purple_get3c = λ&exp. λ{#CON: λ&x. λ&y. λ&z. z; #NIL: @pink_err(#get)}(exp)

// Default handler implementations
// Handlers wrapped in #HFn for tagged dispatch
// Lit handler receives #Cst{n}, returns a value
@purple_h_lit = #HFn{λ&v. v}

// Var handler receives #CON{#Cst{idx}, env}, returns the value
// Default just does standard lookup
@purple_h_var = #HFn{λ&arg.
  λ{#CON: λ&idx. λ&env.
    λ{#Cst: λ&n. @pink_env_get(env)(n); _ : @pink_err(#var)}(idx)
  ; _ : @pink_err(#var)}(arg)}

@purple_h_lam = λ&menv. λ&self. λ&exp.
  λ{#Lam: λ&body.
    !!&env = @purple_menv_env(menv);
    #Clo{env, body}
  ; _ : @pink_err(#lam)}(exp)

// App handler receives #CON{vf, vx} (evaluated function and argument)
// Returns the result of application
// Note: This is a placeholder - actual application uses @purple_apply_menv
@purple_h_app = #HFn{λ&args.
  λ{#CON: λ&vf. λ&vx. @purple_apply_simple(vf)(vx); _ : @pink_err(#happ)}(args)}

// Simple application using purple_eval with fresh menv
// Used by app handler (which doesn't have menv context)
@purple_apply_simple = λf. λx.
  !!&vf = f; !!&vx = x;
  λ{
    #Clo: λ&cenv. λ&body.
      @purple_eval(@purple_menv_new(0)(#NIL)(#CON{vx, cenv}))(body)
    #CloR: λ&cenv. λ&body.
      @purple_eval(@purple_menv_new(0)(#NIL)(#CON{vx, #CON{vf, cenv}}))(body)
    #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
    #KontCps: λ&k. (k(vx))
    #CloCps: λ&cenv. λ&body.
      @purple_eval(@purple_menv_new(0)(#NIL)(#CON{vx, cenv}))(body)
    _ : @pink_err(#app)
  }(vf)

// Default application (for pink compatibility) - curried
@purple_apply_default = λf. λx. @purple_apply_simple(f)(x)

// If handler receives #Cst{n} (evaluated condition), returns #Cst{truth_value}
// truth_value: 0 = false (take else branch), non-0 = true (take then branch)
// Default behavior: pass through unchanged (0 is false, non-0 is true)
@purple_h_if = #HFn{λ&v. v}

@purple_h_lft = λ&menv. λ&self. λ&exp.
  λ{#Lft: λ&e.
    !!&v = self(menv)(e);
    @pink_lift(v)
  ; _ : @pink_err(#lft)}(exp)

@purple_h_run = λ&menv. λ&self. λ&exp.
  λ{#Run: λ&b. λ&e.
    !!&vb = self(menv)(b);
    λ{
      #Cst: λ&n.
        !!&vc = @purple_evalc(menv)(e);
        λ{#Cod: λ&ec. self(menv)(ec); _ : @pink_err(#run)}(vc)
      #Cod: λ&bc.
        !!&vc = @purple_evalc(menv)(e);
        λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
      _ : @pink_err(#run)
    }(vb)
  ; _ : @pink_err(#run)}(exp)

// EM handler: execute at meta-level
@purple_h_em = λ&menv. λ&self. λ&exp.
  λ{#EM: λ&e.
    !!&parent = @purple_ensure_parent(menv);
    self(parent)(e)
  ; _ : @pink_err(#em)}(exp)

// clambda handler: compile under current semantics
@purple_h_clam = λ&menv. λ&self. λ&exp.
  λ{#CLam: λ&body.
    !!&compiled = @purple_evalc(menv)(#Lam{body});
    λ{#Cod: λ&code. self(menv)(code); _ : @pink_err(#clam)}(compiled)
  ; _ : @pink_err(#clam)}(exp)

// Default handler table
@purple_default_handlers = #HTab{
  @purple_h_lit,
  @purple_h_var,
  @purple_h_lam,
  @purple_h_app,
  @purple_h_if,
  @purple_h_lft,
  @purple_h_run,
  @purple_h_em,
  @purple_h_clam
}

// Handler table accessors (0-indexed) - curried for MOV pattern
@purple_htab_get = λt. λi.
  %tab = t; %idx = i;
  λ{#HTab: λ&h0.λ&h1.λ&h2.λ&h3.λ&h4.λ&h5.λ&h6.λ&h7.λ&h8.
    λ{0: h0; 1: h1; 2: h2; 3: h3; 4: h4; 5: h5; 6: h6; 7: h7; 8: h8; _ : @pink_err(#hidx)}(idx)
  ; _ : @pink_err(#htab)}(tab)

// Symbol to handler index mapping
// Maps handler name symbols (nick encoded) to indices: lit=0, var=1, lam=2, app=3, if=4, lft=5, run=6, em=7, clam=8
// Nick encodings: lit=49748, var=90194, lam=49229, app=5136, if=582, lft=49556, run=75086, em=333, clam=835661, add=4356
@purple_sym_to_idx = λ&sym.
  λ{
    49748: 0   // lit
    90194: 1   // var
    49229: 2   // lam
    5136: 3    // app
    582: 4     // if
    49556: 5   // lft
    75086: 6   // run
    333: 7     // em
    835661: 8  // clam
    _ : @pink_err(#symi)
  }(sym)

// Get handler by symbol name - curried
@purple_htab_get_by_sym = λt. λs.
  %tab = t; %sym = s;
  %idx = @purple_sym_to_idx(sym);
  @purple_htab_get(tab)(idx)

// Set handler by symbol name (returns new htab) - curried
@purple_htab_set_by_sym = λt. λs. λh.
  %tab = t; %sym = s; %handler = h;
  %idx = @purple_sym_to_idx(sym);
  λ{#HTab: λ&h0.λ&h1.λ&h2.λ&h3.λ&h4.λ&h5.λ&h6.λ&h7.λ&h8.
    λ{
      0: #HTab{handler, h1, h2, h3, h4, h5, h6, h7, h8}
      1: #HTab{h0, handler, h2, h3, h4, h5, h6, h7, h8}
      2: #HTab{h0, h1, handler, h3, h4, h5, h6, h7, h8}
      3: #HTab{h0, h1, h2, handler, h4, h5, h6, h7, h8}
      4: #HTab{h0, h1, h2, h3, handler, h5, h6, h7, h8}
      5: #HTab{h0, h1, h2, h3, h4, handler, h6, h7, h8}
      6: #HTab{h0, h1, h2, h3, h4, h5, handler, h7, h8}
      7: #HTab{h0, h1, h2, h3, h4, h5, h6, handler, h8}
      8: #HTab{h0, h1, h2, h3, h4, h5, h6, h7, handler}
      _ : @pink_err(#hset)
    }(idx)
  ; _ : @pink_err(#htab)}(tab)

// Get handler from symbol (helper for GMta) - curried
@purple_get_handler = λh. λk.
  %handlers = h; %key = k;
  λ{#Sym: λ&s. @purple_htab_get_by_sym(handlers)(s); _ : @pink_err(#gmta)}(key)

// Set handler and return new menv (helper for SMta) - curried
// Automatically wraps closures for handler dispatch
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_set_handler = λm. λk. λv.
  !!&menv = m; !!&key = k; %val = v;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{#Sym: λ&s.
      !!&wrapped = @purple_wrap_handler(val);
      %new_handlers = @purple_htab_set_by_sym(handlers)(s)(wrapped);
      #MEnv{env, new_handlers, parent, level}
    ; _ : @pink_err(#smta)}(key)
  ; _ : @pink_err(#menv)}(menv)

// Call a handler with one argument - curried
// Uses tagged handlers: #HFn{fn} for HVM4 functions, #HClo{e,b} for Purple closures
// IMPORTANT: Handler bodies evaluate with DEFAULT handlers to avoid infinite recursion
// when the handler body contains the same form type it's handling
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_call1 = λm. λef. λh. λa.
  !!&menv = m; %eval_fn = ef; !!&handler = h; %arg = a;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #HFn: λ&f. f(arg)
      #HClo: λ&e. λ&b. eval_fn(#MEnv{#CON{arg, e}, @purple_default_handlers, parent, level})(b)
      _ : @pink_err(#h1)
    }(handler)
  ; _ : @pink_err(#menv)}(menv)

// Call default handler by symbol name
// Used for handler delegation: (default-handler 'add arg)
// Gets the default handler from @purple_default_handlers and calls it
@purple_call_default_handler = λm. λef. λn. λa.
  !!&menv = m; %eval_fn = ef; !!&name = n; %arg = a;
  λ{#Sym: λ&s.
    !!&handler = @purple_htab_get_by_sym(@purple_default_handlers)(s);
    @purple_call1(menv)(eval_fn)(handler)(arg)
  ; _ : @pink_err(#defh)}(name)

// Wrap a Purple closure for use as a handler
@purple_wrap_handler = λ&clo.
  λ{#Clo: λ&e. λ&b. #HClo{e, b}; _ : @pink_err(#wh)}(clo)

// Constructor argument extraction - curried
// For runtime introspection of AST nodes
@purple_ctr_arg = λc. λi.
  %ctr = c; %idx = i;
  λ{
    #Cst: λ&n.
      // Extract from constructor by index
      λ{
        #Lit: λ&a. λ{0: #Cst{a}; _ : @pink_err(#carg)}(n)
        #Sym: λ&a. λ{0: #Sym{a}; _ : @pink_err(#carg)}(n)
        #Var: λ&a. λ{0: #Cst{a}; _ : @pink_err(#carg)}(n)
        #Lam: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #LamR: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #App: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Let: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #If: λ&a. λ&b. λ&c. λ{0: a; 1: b; 2: c; _ : @pink_err(#carg)}(n)
        #Add: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Sub: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Mul: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Eql: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #CHR: λ&c. λ{0: c; _ : @pink_err(#carg)}(n)
        #CON: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #NIL: @pink_err(#carg)
        #Lft: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #Run: λ&a. λ&b. λ{0: a; 1: b; _ : @pink_err(#carg)}(n)
        #Cod: λ&a. λ{0: #Cod{a}; _ : @pink_err(#carg)}(n)
        #Fst: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #Snd: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #EM: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        #CLam: λ&a. λ{0: a; _ : @pink_err(#carg)}(n)
        _ : @pink_err(#carg)
      }(ctr)
    #Cod: λ&ic. λ{#Cod: λ&cc. #Cod{#CArg{cc, ic}}; _ : @pink_err(#carg)}(ctr)
    _ : @pink_err(#carg)
  }(idx)

// Constructor tag extraction - returns the constructor name as a symbol
// Nick encoding: '_'=0, 'a'-'z'=1-26, 'A'-'Z'=27-52, '0'-'9'=53-62, '$'=63
@purple_ctr_tag = λ&ctr.
  λ{
    #Lit: λ&a. #Sym{156244}
    #Sym: λ&a. #Sym{185933}
    #Var: λ&a. #Sym{196690}
    #Lam: λ&a. #Sym{155725}
    #LamR: λ&a. #Sym{9966444}
    #App: λ&a. λ&b. #Sym{111632}
    #Let: λ&a. λ&b. #Sym{155988}
    #If: λ&a. λ&b. λ&c. #Sym{2246}
    #Add: λ&a. λ&b. #Sym{110852}
    #Sub: λ&a. λ&b. #Sym{185666}
    #Mul: λ&a. λ&b. #Sym{161100}
    #Eql: λ&a. λ&b. #Sym{128076}
    #CHR: λ&a. #Sym{121004}
    #CON: λ&a. λ&b. #Sym{121448}
    #NIL: #Sym{166118}
    #Lft: λ&a. #Sym{156052}
    #Run: λ&a. λ&b. #Sym{181582}
    #Cod: λ&a. #Sym{119748}
    #Fst: λ&a. #Sym{132308}
    #Snd: λ&a. #Sym{185220}
    #EM: λ&a. #Sym{2023}
    #CLam: λ&a. #Sym{7757901}
    #Cst: λ&a. #Sym{120020}
    #Clo: λ&a. λ&b. #Sym{119567}
    #CloR: λ&a. λ&b. #Sym{7652332}
    _ : @pink_err(#ctag)
  }(ctr)

// Purple application (uses menv)
@purple_apply_menv = λ&menv. λ&self. λ&vf. λ&vx.
  λ{
    #Clo: λ&cenv. λ&body.
      !!&new_menv = @purple_menv_with_env(menv)(#CON{vx, cenv});
      self(new_menv)(body)
    #CloR: λ&cenv. λ&body.
      !!&new_menv = @purple_menv_with_env(menv)(#CON{vx, #CON{vf, cenv}});
      self(new_menv)(body)
    #Cod: λ&fcode. λ{#Cod: λ&acode. #Cod{#App{fcode, acode}}; _ : @pink_err(#app)}(vx)
    // Captured CPS continuation - call the native lambda directly
    #KontCps: λ&k. (k(vx))
    // CPS closure - evaluate body with arg bound
    #CloCps: λ&cenv. λ&body.
      !!&new_menv = @purple_menv_with_env(menv)(#CON{vx, cenv});
      self(new_menv)(body)
    _ : @pink_err(#app)
  }(vf)

// =============================================================================
// Pattern Matching Support
// =============================================================================

// Check if a value matches a pattern - curried
// Returns #CON{matched?, bindings_list} where bindings_list is values to bind
// For quoted expressions (#Cod), unwraps and matches against inner value
// NOW SUPPORTS NESTED PATTERNS: sub-patterns in constructor args are recursively matched
@purple_pattern_match = λv. λp.
  !!&val = v; %pattern = p;
  λ{
    // Wildcard matches anything, no bindings
    #PWld: #CON{1, #NIL}

    // Variable pattern matches anything, binds the value
    #PVar: λ&name. #CON{1, #CON{val, #NIL}}

    // Literal pattern matches if value equals literal
    // Uses helper to handle #Cod unwrapping (can't reuse pattern after matching)
    #PLit: λ&n. @purple_match_lit(val)(n)

    // Constructor pattern with nested sub-patterns
    // arg_patterns is a list of patterns (can be nested)
    #PCtr: λ&tag. λ&arg_patterns. @purple_match_ctr(val)(tag)(arg_patterns)

    // Or-pattern: try each alternative until one matches
    #POr: λ&alternatives. @purple_match_or(val)(alternatives)

    // As-pattern: bind name to whole value and also match subpattern
    #PAs: λ&name. λ&subpattern.
      !!&sub_result = @purple_pattern_match(val)(subpattern);
      λ{
        #CON: λ&matched. λ&sub_bindings.
          λ{
            0: #CON{0, #NIL}  // Subpattern didn't match
            λ&m. #CON{1, #CON{val, sub_bindings}}  // Prepend val to bindings
          }(matched)
        _ : #CON{0, #NIL}
      }(sub_result)

    _ : #CON{0, #NIL}
  }(pattern)

// Helper for literal pattern matching with #Cod unwrapping - curried
@purple_match_lit = λv. λn.
  %val = v; %lit = n;
  λ{
    #Cst: λ&v. #CON{(v == lit), #NIL}
    #Cod: λ&inner. @purple_match_lit(inner)(lit)
    _ : #CON{0, #NIL}
  }(val)

// Match an or-pattern: try each alternative until one matches
// Returns the result of the first matching alternative
@purple_match_or = λv. λas.
  !!&val = v; %alts = as;
  λ{
    #NIL: #CON{0, #NIL}  // No alternatives matched
    #CON: λ&alt. λ&rest.
      !!&result = @purple_pattern_match(val)(alt);
      λ{
        #CON: λ&matched. λ&bindings.
          λ{
            0: @purple_match_or(val)(rest)  // Try next alternative
            λ&m. #CON{1, bindings}  // This alternative matched
          }(matched)
        _ : @purple_match_or(val)(rest)
      }(result)
    _ : #CON{0, #NIL}
  }(alts)

// Match a constructor pattern against a value - curried
// tag is the nick-encoded constructor name
// arg_patterns is a list of sub-patterns (can be nested)
// Handles #Cod unwrapping for quoted expressions
// NOTE: Can't use val in default case (HVM4 limitation), so handle each constructor explicitly
@purple_match_ctr = λv. λt. λa.
  %val = v; %tag = t; %arg_patterns = a;
  λ{
    #Cod: λ&inner. @purple_match_ctr(inner)(tag)(arg_patterns)
    #Lit: λ&a. @purple_match_tag_and_args(156244)(tag)(#CON{#Cst{a}, #NIL})(arg_patterns)
    #Sym: λ&a. @purple_match_tag_and_args(185933)(tag)(#CON{#Sym{a}, #NIL})(arg_patterns)
    #Var: λ&a. @purple_match_tag_and_args(196690)(tag)(#CON{#Cst{a}, #NIL})(arg_patterns)
    #Lam: λ&a. @purple_match_tag_and_args(155725)(tag)(#CON{a, #NIL})(arg_patterns)
    #LamR: λ&a. @purple_match_tag_and_args(9966444)(tag)(#CON{a, #NIL})(arg_patterns)
    #App: λ&a. λ&b. @purple_match_tag_and_args(111632)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #Let: λ&a. λ&b. @purple_match_tag_and_args(155988)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #If: λ&a. λ&b. λ&c. @purple_match_tag_and_args(2246)(tag)(#CON{a, #CON{b, #CON{c, #NIL}}})(arg_patterns)
    #Add: λ&a. λ&b. @purple_match_tag_and_args(110852)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #Sub: λ&a. λ&b. @purple_match_tag_and_args(185666)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #Mul: λ&a. λ&b. @purple_match_tag_and_args(161100)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #Eql: λ&a. λ&b. @purple_match_tag_and_args(128076)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #CHR: λ&c. @purple_match_tag_and_args(121004)(tag)(#CON{#Cst{c}, #NIL})(arg_patterns)
    #CON: λ&a. λ&b. @purple_match_tag_and_args(121448)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #NIL: @purple_match_tag_and_args(166118)(tag)(#NIL)(arg_patterns)
    #Lft: λ&a. @purple_match_tag_and_args(156052)(tag)(#CON{a, #NIL})(arg_patterns)
    #Run: λ&a. λ&b. @purple_match_tag_and_args(181582)(tag)(#CON{a, #CON{b, #NIL}})(arg_patterns)
    #Fst: λ&a. @purple_match_tag_and_args(132308)(tag)(#CON{a, #NIL})(arg_patterns)
    #Snd: λ&a. @purple_match_tag_and_args(185220)(tag)(#CON{a, #NIL})(arg_patterns)
    #EM: λ&a. @purple_match_tag_and_args(2023)(tag)(#CON{a, #NIL})(arg_patterns)
    #CLam: λ&a. @purple_match_tag_and_args(7757901)(tag)(#CON{a, #NIL})(arg_patterns)
    #Cst: λ&a. @purple_match_tag_and_args(120020)(tag)(#CON{#Cst{a}, #NIL})(arg_patterns)
    #Clo: λ&e. λ&b. @purple_match_tag_and_args(119567)(tag)(#CON{e, #CON{b, #NIL}})(arg_patterns)
    #CloR: λ&e. λ&b. @purple_match_tag_and_args(7652332)(tag)(#CON{e, #CON{b, #NIL}})(arg_patterns)
    _ : #CON{0, #NIL}  // Unknown constructor - no match
  }(val)

// Compare tags, then recursively match sub-patterns against extracted args
// Returns #CON{matched?, bindings_list}
// Fast path: if all patterns are simple PVar, return extracted_args directly
// Slow path: nested patterns need recursive matching
@purple_match_tag_and_args = λvt. λpt. λea. λap.
  %val_tag = vt; %pattern_tag = pt; %extracted_args = ea; %arg_patterns = ap;
  λ{
    0: #CON{0, #NIL}  // Tags don't match
    _ : λ&u.
      !!&all_simple = @purple_all_pvar(arg_patterns);
      λ{
        1: #CON{1, extracted_args}  // All PVar - return args directly
        _ : λ&u2. @purple_match_args(extracted_args)(arg_patterns)
      }(all_simple)
  }((val_tag == pattern_tag))

// Check if all patterns in list are simple PVar
@purple_all_pvar = λps.
  λ{
    #NIL: 1
    #CON: λ&p. λ&rest.
      λ{
        #PVar: λ&n. @purple_all_pvar(rest)
        _ : λ&u. 0
      }(p)
    _ : 0
  }(ps)

// Recursively match a list of values against a list of patterns
// Returns #CON{all_matched?, all_bindings}
// Base case: both empty -> success with no bindings
// Values but no patterns -> fail
// Patterns but no values -> fail
// Both have elements -> match first, if ok recurse on rest
@purple_match_args = λvs. λ&ps.
  λ{
    #NIL: λ{#NIL: #CON{1, #NIL}; _ : #CON{0, #NIL}}(ps)
    #CON: λ&v. λ&vr.
      λ{
        #NIL: #CON{0, #NIL}
        #CON: λ&p. λ&pr. @purple_match_one_then_rest(v)(p)(vr)(pr)
        _ : #CON{0, #NIL}
      }(ps)
    _ : #CON{0, #NIL}
  }(vs)

// Match one value against pattern, then continue with rest if successful
// NOTE: Variable names use short forms (bs/rbs) to avoid HVM4 nick collisions
@purple_match_one_then_rest = λv. λp. λvr. λpr.
  !!&match_result = @purple_pattern_match(v)(p);
  λ{
    #CON: λ&ok. λ&bs.
      λ{
        0: #CON{0, #NIL}
        λ&ign1.
          !!&rest_result = @purple_match_args(vr)(pr);
          λ{
            #CON: λ&rok. λ&rbs.
              λ{
                0: #CON{0, #NIL}
                λ&ign2. #CON{1, @purple_list_concat(bs)(rbs)}
              }(rok)
            _ : #CON{0, #NIL}
          }(rest_result)
      }(ok)
    _ : #CON{0, #NIL}
  }(match_result)

// Concatenate two lists
@purple_list_concat = λa. λ&b.
  λ{
    #NIL: b
    #CON: λ&h. λ&t. #CON{h, @purple_list_concat(t)(b)}
    _ : b
  }(a)

// Try each case until one matches (legacy - now compiled to native HVM4 match) - curried
// Returns the result of the matching case's body
// NOTE: Pattern matching is now compiled to native HVM4 at compile-time
// This function is kept for backward compatibility with dynamic match expressions
@purple_try_cases = λm. λef. λv. λc.
  %menv = m; %eval_fn = ef; %val = v; %cases = c;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    @purple_try_cases_inner(env)(handlers)(parent)(level)(eval_fn)(val)(cases)
  ; _ : @pink_err(#menv)}(menv)

// Try each case: #Case{pattern, guard, body}
// Guard can be #NIL (no guard) or an expression to evaluate
// If guard is present and evaluates to 0/#F, continue to next case
@purple_try_cases_inner = λe. λh. λp. λl. λef. λv. λc.
  %env = e; %handlers = h; %parent = p; %level = l; %eval_fn = ef; %val = v; %cases = c;
  λ{
    #NIL: @pink_err(#nmch)  // No case matched
    #CON: λ&case. λ&rest.
      λ{
        #Case: λ&pattern. λ&guard. λ&body.
          %match_result = @purple_pattern_match(val)(pattern);
          λ{
            #CON: λ&matched. λ&bds.
              λ{
                0: @purple_try_cases_inner(env)(handlers)(parent)(level)(eval_fn)(val)(rest)  // Try next case
                λ&u.
                  // Pattern matched! Now check the guard
                  %new_env = @purple_bind_all(env)(bds);
                  @purple_check_guard(new_env)(handlers)(parent)(level)(eval_fn)(guard)(body)(val)(rest)
              }(matched)
            _ : @pink_err(#mat)
          }(match_result)
        _ : @pink_err(#case)
      }(case)
    _ : @pink_err(#cases)
  }(cases)

// Check guard expression, evaluate body if guard passes
// NOTE: Variables used in multiple branches need DUP bindings
@purple_check_guard = λne. λh. λp. λl. λef. λg. λbd. λv. λr.
  !!&new_env = ne; !!&handlers = h; !!&parent = p; !!&level = l; !!&eval_fn = ef;
  !!&guard = g; !!&body = bd; !!&val = v; !!&rest = r;
  λ{
    #NIL:
      // No guard - evaluate body directly
      eval_fn(#MEnv{new_env, handlers, parent, level})(body)
    _ : λ&u.
      // Evaluate guard expression in the new environment (with pattern bindings)
      !!&guard_result = eval_fn(#MEnv{new_env, handlers, parent, level})(guard);
      @purple_check_guard_result(new_env)(handlers)(parent)(level)(eval_fn)(guard_result)(body)(val)(rest)
  }(guard)

// Check if guard result is truthy
// NOTE: Variables used in multiple branches need DUP bindings
@purple_check_guard_result = λne. λh. λp. λl. λef. λgr. λbd. λv. λr.
  !!&new_env = ne; !!&handlers = h; !!&parent = p; !!&level = l; !!&eval_fn = ef;
  !!&guard_result = gr; !!&body = bd; !!&val = v; !!&rest = r;
  λ{
    #Cst: λ&n.
      λ{
        0: @purple_try_cases_inner(new_env)(handlers)(parent)(level)(eval_fn)(val)(rest)  // Guard failed - try next case
        λ&m. eval_fn(#MEnv{new_env, handlers, parent, level})(body)  // Guard passed - evaluate body
      }(n)
    #Sym: λ&s.
      // Symbol #F is false, anything else is true
      λ{
        #F: @purple_try_cases_inner(new_env)(handlers)(parent)(level)(eval_fn)(val)(rest)
        _ : λ&u. eval_fn(#MEnv{new_env, handlers, parent, level})(body)
      }(s)
    _ : λ&u.
      // Any other value is truthy
      eval_fn(#MEnv{new_env, handlers, parent, level})(body)
  }(guard_result)

// Bind a list of values to environment - curried
// Bindings list is in order [first, second, ...]
// We need first binding at index 0 (head of env)
// So we prepend in reverse order: bind last first, then second-to-last, etc.
@purple_bind_all = λe. λb.
  %env = e; %bindings = b;
  @purple_bind_fold(env)(bindings)

// Prepend bindings in order - first binding ends up deepest - curried
// Then we need to reverse the final env...
// Actually simpler: just use this and adjust de Bruijn indices in pattern matching
@purple_bind_fold = λe. λb.
  %env = e; %bindings = b;
  λ{
    #NIL: env
    #CON: λ&val.λ&rest. @purple_bind_fold(#CON{val, env})(rest)
    _ : env
  }(bindings)

// Evaluate a list of expressions and return evaluated list - curried
@purple_eval_list = λm. λef. λl.
  %menv = m; %eval_fn = ef; %lst = l;
  λ{
    #NIL: #NIL
    #CON: λ&head. λ&tail.
      %vh = eval_fn(menv)(head);
      %vt = @purple_eval_list(menv)(eval_fn)(tail);
      #CON{vh, vt}
    _ : #NIL
  }(lst)

// Continue after evaluating first expression in do block - curried
// If vf is an FFI marker, chain it (FFI results need special handling)
// Otherwise, just continue evaluating rest
@purple_do_continue = λm. λef. λf. λr.
  %menv = m; %eval_fn = ef; %vf = f; %rest = r;
  λ{
    // If first result is FFI, we need to chain: #Do{#FFI{...}, rest}
    // This allows the C driver to execute FFI calls in sequence
    // Preserve the current menv so the continuation evaluates in the right context
    #FFI: λ&name. λ&args. #Do{#FFI{name, args}, #WMnv{menv, rest}}
    // For non-FFI values, just discard and continue
    _ : λ&u. eval_fn(menv)(rest)
  }(vf)

// =============================================================================
// Delimited Continuations via CPS Transformation
// =============================================================================
//
// Purple implements delimited continuations (reset/control) using a CPS-style
// evaluator. The key insight is that HVM4's interaction nets are fundamentally
// lambda calculus, so continuations can be captured as native lambdas.
//
// How it works:
// 1. (reset body) enters CPS evaluation mode via @purple_eval_cps
// 2. In CPS mode, every expression takes an explicit continuation parameter k
// 3. (control k body) captures k as #KontCps{lambda} and binds it
// 4. When the captured continuation is called, it invokes the lambda directly
//
// Example: (reset (+ 10 (control k (+ (k 3) (k 5))))) => 28
//   - Entering reset: call @purple_eval_cps with identity continuation (λv. v)
//   - Evaluating (+ 10 _): k becomes (λv. (+ 10 v)) in CPS
//   - control captures k as #KontCps{λv. #Cst{(10 + v)}}
//   - (k 3) calls the lambda with 3 → #Cst{13}
//   - (k 5) calls the lambda with 5 → #Cst{15}
//   - (+ 13 15) → 28
//
// This approach:
// - Captures full continuation context (not just arithmetic frames)
// - Supports multiple calls to the same continuation
// - Works with nested function calls and control flow
// - Leverages HVM4's native lambda mechanism for efficiency
//
// Value types:
// - #CloCps{env, body}: Closure created inside reset (evaluated in CPS mode)
// - #KontCps{k}: Captured continuation (k is a native HVM lambda)

// Helper to unwrap #Cst
@purple_unwrap_cst = λv. λ{#Cst: λ&n. n; _ : 0}(v)

// CPS evaluator - takes menv, expression, and continuation k
@purple_eval_cps = λm. λexp. λk.
  %menv = m; %kont = k; %e = exp;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #Lit: λ&n. (kont(#Cst{n}))

      #Fix: λ&hi. λ&lo. λ&scale. (kont(#Fix{hi, lo, scale}))

      #Ptr: λ&hi. λ&lo. (kont(#Ptr{hi, lo}))

      #Var: λ&n. (kont(@pink_env_get(env)(n)))

      #Lam: λ&body. (kont(#CloCps{env, body}))

      #App: λ&f. λ&x.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(f)(λvf.
          @purple_eval_cps(#MEnv{env, handlers, parent, level})(x)(λvx.
            @purple_apply_cps(#MEnv{env, handlers, parent, level})(vf)(vx)(kont)))

      #Add: λ&a. λ&b.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(a)(λva.
          @purple_eval_cps(#MEnv{env, handlers, parent, level})(b)(λvb.
            (kont(#Cst{(@purple_unwrap_cst(va) + @purple_unwrap_cst(vb))}))))

      #Sub: λ&a. λ&b.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(a)(λva.
          @purple_eval_cps(#MEnv{env, handlers, parent, level})(b)(λvb.
            (kont(#Cst{(@purple_unwrap_cst(va) - @purple_unwrap_cst(vb))}))))

      #Mul: λ&a. λ&b.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(a)(λva.
          @purple_eval_cps(#MEnv{env, handlers, parent, level})(b)(λvb.
            (kont(#Cst{(@purple_unwrap_cst(va) * @purple_unwrap_cst(vb))}))))

      #If: λ&c. λ&t. λ&e.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(c)(λvc.
          λ{
            #Cst: λ&n. λ{
              0: @purple_eval_cps(#MEnv{env, handlers, parent, level})(e)(kont)
              _ : @purple_eval_cps(#MEnv{env, handlers, parent, level})(t)(kont)
            }(n)
            _ : @pink_err(#if)
          }(vc))

      #Let: λ&val. λ&body.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(val)(λvv.
          @purple_eval_cps(#MEnv{#CON{vv, env}, handlers, parent, level})(body)(kont))

      // Nested reset - creates new delimiter
      #Prmt: λ&body.
        !!&result = @purple_eval_cps(#MEnv{env, handlers, parent, level})(body)(λv. v);
        (kont(result))

      // Control - capture the continuation!
      #Ctrl: λ&k_idx. λ&body.
        // kont is the current continuation (a native HVM lambda)
        // Wrap it as a callable Purple value
        !!&k_val = #KontCps{kont};
        // Evaluate body with k bound, using identity continuation
        // (the body's result becomes the reset's result)
        @purple_eval_cps(#MEnv{#CON{k_val, env}, handlers, parent, level})(body)(λv. v)

      // For other forms, fall back to direct evaluation then continue
      _ : (kont(@purple_eval(#MEnv{env, handlers, parent, level})(e)))
    }(e)
  ; _ : @pink_err(#cps)}(menv)

// CPS application - handles CPS closures and captured continuations
@purple_apply_cps = λm. λvf. λvx. λk.
  %menv = m; %kont = k; %arg = vx; %func = vf;
  λ{
    // CPS closure created inside reset
    #CloCps: λ&cenv. λ&body.
      λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
        @purple_eval_cps(#MEnv{#CON{arg, cenv}, handlers, parent, level})(body)(kont)
      ; _ : @pink_err(#app)}(menv)

    // Captured continuation - call it!
    #KontCps: λ&saved_k.
      // Apply saved continuation to argument, then pass result to current k
      !!&result = (saved_k(arg));
      (kont(result))

    // Regular closure from outside reset
    #Clo: λ&cenv. λ&body.
      λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
        // Evaluate body in direct style, then continue
        !!&result = @purple_eval(#MEnv{#CON{arg, cenv}, handlers, parent, level})(body);
        (kont(result))
      ; _ : @pink_err(#app)}(menv)

    _ : @pink_err(#app)
  }(func)

// Purple evaluator - uses MOV for efficient bindings, direct @-recursion
// NOTE: Uses single-destructure pattern to avoid menv duplication issues in HVM4
@purple_eval = λm. λexp.
  %menv = m;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #Lit: λ&n.
        !!&h = @purple_htab_get(handlers)(0);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#Cst{n})
      #Fix: λ&hi. λ&lo. λ&scale. #Fix{hi, lo, scale}
      #Ptr: λ&hi. λ&lo. #Ptr{hi, lo}
      #Sym: λ&s. #Sym{s}
      #Var: λ&n.
        !!&h = @purple_htab_get(handlers)(1);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#CON{#Cst{n}, env})
      #Lam: λ&body. #Clo{env, body}
      #LamR: λ&body. #CloR{env, body}
      #App: λ&f. λ&x.
        !!&vf = @purple_eval(#MEnv{env, handlers, parent, level})(f);
        !!&vx = @purple_eval(#MEnv{env, handlers, parent, level})(x);
        // Call app handler with evaluated function and argument
        !!&h = @purple_htab_get(handlers)(3);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#CON{vf, vx})
      #Let: λ&val. λ&body.
        !!&vv = @purple_eval(#MEnv{env, handlers, parent, level})(val);
        @purple_eval(#MEnv{#CON{vv, env}, handlers, parent, level})(body)
      #Mov: λ&val. λ&body.
        !!&vv = @purple_eval(#MEnv{env, handlers, parent, level})(val);
        @purple_eval(#MEnv{#CON{vv, env}, handlers, parent, level})(body)
      #If: λ&c. λ&t. λ&e.
        !!&vc = @purple_eval(#MEnv{env, handlers, parent, level})(c);
        λ{
          #Cst: λ&n.
            // Call if handler to interpret the condition
            !!&h = @purple_htab_get(handlers)(4);
            !!&truth = @purple_call1(#MEnv{env, handlers, parent, level})(@purple_eval)(h)(#Cst{n});
            λ{#Cst: λ&tv. λ{0: @purple_eval(#MEnv{env, handlers, parent, level})(e); λ&m. @purple_eval(#MEnv{env, handlers, parent, level})(t)}(tv); _ : @pink_err(#if)}(truth)
          #Cod: λ&cc.
            !!&vt = @purple_evalc(#MEnv{env, handlers, parent, level})(t);
            !!&ve = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
          _ : @pink_err(#if)
        }(vc)
      #Lft: λ&e.
        !!&v = @purple_eval(#MEnv{env, handlers, parent, level})(e);
        @pink_lift(v)
      #Run: λ&b. λ&e.
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cod: λ&bc.
            !!&vc = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
          _ : λ&u.
            !!&vc = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&ec. @purple_eval(#MEnv{env, handlers, parent, level})(ec); _ : @pink_err(#run)}(vc)
        }(vb)
      #Cod: λ&e. #Cod{e}
      #Add: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na + nb)}; #Cod: λ&cb. #Cod{#Add{#Lit{na}, cb}}; _ : @pink_err(#add)}(vb)
          #Fix: λ&h1. λ&l1. λ&s1. @fix_add(#Fix{h1, l1, s1})(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
          _ : @pink_err(#add)
        }(va)
      #Sub: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na - nb)}; #Cod: λ&cb. #Cod{#Sub{#Lit{na}, cb}}; _ : @pink_err(#sub)}(vb)
          #Fix: λ&h1. λ&l1. λ&s1. @fix_sub(#Fix{h1, l1, s1})(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
          _ : @pink_err(#sub)
        }(va)
      #Mul: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na * nb)}; #Cod: λ&cb. #Cod{#Mul{#Lit{na}, cb}}; _ : @pink_err(#mul)}(vb)
          #Fix: λ&h1. λ&l1. λ&s1. @fix_mul(#Fix{h1, l1, s1})(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
          _ : @pink_err(#mul)
        }(va)
      #Eql: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na == nb)}; _ : @pink_err(#eql)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
          _ : @pink_err(#eql)
        }(va)
      #Lt: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na < nb)}; _ : @pink_err(#lt)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Lt{ca, cb}}; _ : @pink_err(#lt)}(vb)
          _ : @pink_err(#lt)
        }(va)
      #Gt: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na > nb)}; _ : @pink_err(#gt)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Gt{ca, cb}}; _ : @pink_err(#gt)}(vb)
          _ : @pink_err(#gt)
        }(va)
      #Le: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na <= nb)}; _ : @pink_err(#le)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Le{ca, cb}}; _ : @pink_err(#le)}(vb)
          _ : @pink_err(#le)
        }(va)
      #Ge: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na >= nb)}; _ : @pink_err(#ge)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Ge{ca, cb}}; _ : @pink_err(#ge)}(vb)
          _ : @pink_err(#ge)
        }(va)
      #Div: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na / nb)}; _ : @pink_err(#div)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Div{ca, cb}}; _ : @pink_err(#div)}(vb)
          _ : @pink_err(#div)
        }(va)
      #Mod: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. #Cst{(na % nb)}; _ : @pink_err(#mod)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mod{ca, cb}}; _ : @pink_err(#mod)}(vb)
          _ : @pink_err(#mod)
        }(va)
      #And: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: #Cst{0}; λ&m. @purple_eval(#MEnv{env, handlers, parent, level})(b)}(na)
          #Cod: λ&ca.
            !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
            λ{#Cod: λ&cb. #Cod{#And{ca, cb}}; _ : @pink_err(#and)}(vb)
          _ : @pink_err(#and)
        }(va)
      #Or: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: @purple_eval(#MEnv{env, handlers, parent, level})(b); λ&m. #Cst{1}}(na)
          #Cod: λ&ca.
            !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
            λ{#Cod: λ&cb. #Cod{#Or{ca, cb}}; _ : @pink_err(#or)}(vb)
          _ : @pink_err(#or)
        }(va)
      #Not: λ&a.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: #Cst{1}; λ&m. #Cst{0}}(na)
          #Cod: λ&ca. #Cod{#Not{ca}}
          _ : @pink_err(#not)
        }(va)
      #CON: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
          _ : λ&u. #CON{va, vb}
        }(va)
      #NIL: #NIL
      #CHR: λ&c. #CHR{c}
      #Fst: λ&p.
        !!&vp = @purple_eval(#MEnv{env, handlers, parent, level})(p);
        λ{
          #CON: λ&a. λ&b. a
          #Cod: λ&pc. #Cod{#Fst{pc}}
          _ : @pink_err(#fst)
        }(vp)
      #Snd: λ&p.
        !!&vp = @purple_eval(#MEnv{env, handlers, parent, level})(p);
        λ{
          #CON: λ&a. λ&b. b
          #Cod: λ&pc. #Cod{#Snd{pc}}
          _ : @pink_err(#snd)
        }(vp)
      #EM: λ&e.
        !!&new_parent = @purple_ensure_parent(#MEnv{env, handlers, parent, level});
        @purple_eval(new_parent)(e)
      #CLam: λ&body.
        !!&compiled = @purple_evalc(#MEnv{env, handlers, parent, level})(#Lam{body});
        λ{#Cod: λ&code. @purple_eval(#MEnv{env, handlers, parent, level})(code); _ : @pink_err(#clam)}(compiled)
      #GMta: λ&key.
        !!&vk = @purple_eval(#MEnv{env, handlers, parent, level})(key);
        @purple_get_handler(handlers)(vk)
      #SMta: λ&key. λ&val.
        !!&vk = @purple_eval(#MEnv{env, handlers, parent, level})(key);
        !!&vv = @purple_eval(#MEnv{env, handlers, parent, level})(val);
        @purple_set_handler(#MEnv{env, handlers, parent, level})(vk)(vv)
      #SEq: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Sym: λ&sa. λ{#Sym: λ&sb. #Cst{(sa == sb)}; _ : @pink_err(#seq)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#SEq{ca, cb}}; _ : @pink_err(#seq)}(vb)
          _ : @pink_err(#seq)
        }(va)
      #WMnv: λ&m. λ&body.
        !!&new_menv = @purple_eval(#MEnv{env, handlers, parent, level})(m);
        λ{#MEnv: λ&e. λ&h. λ&p. λ&l. @purple_eval(new_menv)(body); _ : @pink_err(#wmenv)}(new_menv)
      #CArg: λ&c. λ&i.
        !!&vc = @purple_eval(#MEnv{env, handlers, parent, level})(c);
        !!&vi = @purple_eval(#MEnv{env, handlers, parent, level})(i);
        @purple_ctr_arg(vc)(vi)
      #CTag: λ&e.
        !!&ve = @purple_eval(#MEnv{env, handlers, parent, level})(e);
        @purple_ctr_tag(ve)
      #Eval: λ&e.
        !!&ve = @purple_eval(#MEnv{env, handlers, parent, level})(e);
        // If result is #Cod{code}, evaluate code; otherwise evaluate ve as syntax
        // NOTE: Must use λ&u. instead of _ : to properly consume the matched value in HVM4
        λ{#Cod: λ&code. @purple_eval(#MEnv{env, handlers, parent, level})(code); λ&u. @purple_eval(#MEnv{env, handlers, parent, level})(ve)}(ve)
      #MLvl: #Cst{level}
      #Shft: λ&n. λ&e.
        !!&vn = @purple_eval(#MEnv{env, handlers, parent, level})(n);
        λ{#Cst: λ&cnt. @purple_shift_levels(#MEnv{env, handlers, parent, level})(@purple_eval)(cnt)(e); _ : @pink_err(#shft)}(vn)
      #Mat: λ&expr. λ&cases.
        !!&val = @purple_eval(#MEnv{env, handlers, parent, level})(expr);
        @purple_try_cases(#MEnv{env, handlers, parent, level})(@purple_eval)(val)(cases)
      // Native match: scrutinee is evaluated, then native HVM4 pattern matching applied
      // The matcher returns #CON{body, bindings_list} where bindings need to be added to env
      // This is only used for simple patterns without wildcards + args (see compiler check)
      #NMat: λ&scrutinee. λ&matcher.
        !!&val = @purple_eval(#MEnv{env, handlers, parent, level})(scrutinee);
        !!&result = matcher(val);
        // Extract body and bindings from result
        λ{#CON: λ&body. λ&bindings.
          // Bind the extracted values to the environment
          %new_env = @purple_bind_all(env)(bindings);
          @purple_eval(#MEnv{new_env, handlers, parent, level})(body)
        ; _ : @pink_err(#nmat)}(result)
      #FFI: λ&name. λ&args.
        // Evaluate all arguments, return FFI marker for C driver to interpret
        %vargs = @purple_eval_list(#MEnv{env, handlers, parent, level})(@purple_eval)(args);
        #FFI{name, vargs}
      #Do: λ&first. λ&rest.
        // Evaluate first, discard result, evaluate rest
        !!&vf = @purple_eval(#MEnv{env, handlers, parent, level})(first);
        @purple_do_continue(#MEnv{env, handlers, parent, level})(@purple_eval)(vf)(rest)
      // Default handler delegation: (default-handler 'name arg)
      // Calls the default handler for a given handler name symbol
      #DefH: λ&name. λ&arg.
        !!&vname = @purple_eval(#MEnv{env, handlers, parent, level})(name);
        !!&varg = @purple_eval(#MEnv{env, handlers, parent, level})(arg);
        // Get default handler by name and call it
        @purple_call_default_handler(#MEnv{env, handlers, parent, level})(@purple_eval)(vname)(varg)
      // Error: (error msg) -> raises an error with the evaluated message
      #ErrR: λ&msg.
        !!&vmsg = @purple_eval(#MEnv{env, handlers, parent, level})(msg);
        #Err{vmsg}
      // Try: (try expr handler) -> catch errors with handler
      #Try: λ&expr. λ&handler.
        !!&vexpr = @purple_eval(#MEnv{env, handlers, parent, level})(expr);
        !!&vhandler = @purple_eval(#MEnv{env, handlers, parent, level})(handler);
        λ{
          #Err: λ&msg. @purple_apply_menv(#MEnv{env, handlers, parent, level})(@purple_eval)(vhandler)(msg)
          λ&u. vexpr
        }(vexpr)
      // Assert: (assert cond msg) -> raise error if cond is false
      #Asrt: λ&cond. λ&msg.
        !!&vcond = @purple_eval(#MEnv{env, handlers, parent, level})(cond);
        λ{
          #Cst: λ&n. λ{0: !!&vmsg = @purple_eval(#MEnv{env, handlers, parent, level})(msg); #Err{vmsg}; λ&u. #Cst{1}}(n)
          λ&u. @pink_err(#asrt)
        }(vcond)
      // Trace: (trace expr) -> evaluate and return #Traced{value}
      #Trce: λ&expr.
        !!&vexpr = @purple_eval(#MEnv{env, handlers, parent, level})(expr);
        #Traced{vexpr}
      // Reify-env: return current environment as a value
      #REnv: env
      // Gensym: generate a unique symbol from index n
      // Returns #Sym{10000000 + n} to create symbols in a reserved range
      #GSym: λ&n.
        !!&vn = @purple_eval(#MEnv{env, handlers, parent, level})(n);
        λ{#Cst: λ&idx. #Sym{(10000000 + idx)}; λ&u. @pink_err(#gsym)}(vn)
      // Quasiquote: process expression, evaluating unquotes
      #QQ: λ&inner.
        @purple_qq_process(#MEnv{env, handlers, parent, level})(@purple_eval)(inner)
      // Unquote outside quasiquote is an error
      #UQ: λ&inner.
        @pink_err(#uq)
      // Unquote-splicing outside quasiquote is an error
      #UQS: λ&inner.
        @pink_err(#uqs)
      // List operations
      #Map: λ&fn. λ&lst.
        !!&vfn = @purple_eval(#MEnv{env, handlers, parent, level})(fn);
        !!&vlst = @purple_eval(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_map(#MEnv{env, handlers, parent, level})(vfn)(vlst)
      #Fltr: λ&fn. λ&lst.
        !!&vfn = @purple_eval(#MEnv{env, handlers, parent, level})(fn);
        !!&vlst = @purple_eval(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_filter(#MEnv{env, handlers, parent, level})(vfn)(vlst)
      #Fold: λ&fn. λ&init. λ&lst.
        !!&vfn = @purple_eval(#MEnv{env, handlers, parent, level})(fn);
        !!&vinit = @purple_eval(#MEnv{env, handlers, parent, level})(init);
        !!&vlst = @purple_eval(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_foldr(#MEnv{env, handlers, parent, level})(vfn)(vinit)(vlst)
      #FdLf: λ&fn. λ&init. λ&lst.
        !!&vfn = @purple_eval(#MEnv{env, handlers, parent, level})(fn);
        !!&vinit = @purple_eval(#MEnv{env, handlers, parent, level})(init);
        !!&vlst = @purple_eval(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_foldl(#MEnv{env, handlers, parent, level})(vfn)(vinit)(vlst)
      #Len: λ&lst.
        !!&vlst = @purple_eval(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_length(vlst)
      #Apnd: λ&a. λ&b.
        !!&va = @purple_eval(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_eval(#MEnv{env, handlers, parent, level})(b);
        @purple_list_append(va)(vb)
      #Rev: λ&lst.
        !!&vlst = @purple_eval(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_reverse(vlst)
      // Higher-order function utilities
      #Comp: λ&f. λ&g.
        !!&vf = @purple_eval(#MEnv{env, handlers, parent, level})(f);
        !!&vg = @purple_eval(#MEnv{env, handlers, parent, level})(g);
        @purple_compose(#MEnv{env, handlers, parent, level})(vf)(vg)
      #Flip: λ&f.
        !!&vf = @purple_eval(#MEnv{env, handlers, parent, level})(f);
        @purple_flip(#MEnv{env, handlers, parent, level})(vf)
      #Appl: λ&f. λ&args.
        !!&vf = @purple_eval(#MEnv{env, handlers, parent, level})(f);
        !!&vargs = @purple_eval(#MEnv{env, handlers, parent, level})(args);
        @purple_apply_to_list(#MEnv{env, handlers, parent, level})(vf)(vargs)
      // Delimited continuations - reset enters CPS evaluation mode
      // This allows control to capture the continuation as a native lambda
      #Prmt: λ&body.
        @purple_eval_cps(#MEnv{env, handlers, parent, level})(body)(λv. v)
      // Control outside reset is an error
      #Ctrl: λ&k_idx. λ&body.
        @pink_err(#ctrl)
      _ : @pink_err(#pexp)
    }(exp)
  ; _ : @pink_err(#menv)}(menv)

// Purple compile-mode evaluator - lifts values to code
@purple_evalc = λm. λexp.
  %menv = m;
  λ{#MEnv: λ&env. λ&handlers. λ&parent. λ&level.
    λ{
      #Lit: λ&n.
        !!&h = @purple_htab_get(handlers)(0);
        @pink_lift(@purple_call1(#MEnv{env, handlers, parent, level})(@purple_evalc)(h)(#Cst{n}))
      #Fix: λ&hi. λ&lo. λ&scale. @pink_lift(#Fix{hi, lo, scale})
      #Ptr: λ&hi. λ&lo. @pink_lift(#Ptr{hi, lo})
      #Sym: λ&s. @pink_lift(#Sym{s})
      #Var: λ&n.
        !!&h = @purple_htab_get(handlers)(1);
        @pink_lift(@purple_call1(#MEnv{env, handlers, parent, level})(@purple_evalc)(h)(#CON{#Cst{n}, env}))
      #Lam: λ&body. @pink_lift(#Clo{env, body})
      #LamR: λ&body. @pink_lift(#CloR{env, body})
      #App: λ&f. λ&x.
        !!&vf = @purple_evalc(#MEnv{env, handlers, parent, level})(f);
        !!&vx = @purple_evalc(#MEnv{env, handlers, parent, level})(x);
        // Call app handler with evaluated function and argument
        !!&h = @purple_htab_get(handlers)(3);
        @purple_call1(#MEnv{env, handlers, parent, level})(@purple_evalc)(h)(#CON{vf, vx})
      #Let: λ&val. λ&body.
        !!&vv = @purple_evalc(#MEnv{env, handlers, parent, level})(val);
        @purple_evalc(#MEnv{#CON{vv, env}, handlers, parent, level})(body)
      #Mov: λ&val. λ&body.
        !!&vv = @purple_evalc(#MEnv{env, handlers, parent, level})(val);
        @purple_evalc(#MEnv{#CON{vv, env}, handlers, parent, level})(body)
      #If: λ&c. λ&t. λ&e.
        !!&vc = @purple_evalc(#MEnv{env, handlers, parent, level})(c);
        λ{
          #Cst: λ&n.
            // Call if handler to interpret the condition
            !!&h = @purple_htab_get(handlers)(4);
            %truth = @purple_call1(#MEnv{env, handlers, parent, level})(@purple_evalc)(h)(#Cst{n});
            λ{#Cst: λ&tv. λ{0: @purple_evalc(#MEnv{env, handlers, parent, level})(e); λ&m. @purple_evalc(#MEnv{env, handlers, parent, level})(t)}(tv); _ : @pink_err(#if)}(truth)
          #Cod: λ&cc.
            !!&vt = @purple_evalc(#MEnv{env, handlers, parent, level})(t);
            !!&ve = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&tc. λ{#Cod: λ&ec. #Cod{#If{cc, tc, ec}}; _ : @pink_err(#if)}(ve); _ : @pink_err(#if)}(vt)
          _ : @pink_err(#if)
        }(vc)
      #Lft: λ&e.
        %v = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
        @pink_lift(v)
      #Run: λ&b. λ&e.
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cod: λ&bc.
            !!&vc = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&ec. #Cod{#Run{bc, ec}}; _ : @pink_err(#run)}(vc)
          _ : λ&u.
            !!&vc = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
            λ{#Cod: λ&ec. @purple_evalc(#MEnv{env, handlers, parent, level})(ec); _ : @pink_err(#run)}(vc)
        }(vb)
      #Cod: λ&e. #Cod{e}
      #Add: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na + nb)}); _ : @pink_err(#add)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Add{ca, cb}}; _ : @pink_err(#add)}(vb)
          _ : @pink_err(#add)
        }(va)
      #Sub: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na - nb)}); _ : @pink_err(#sub)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Sub{ca, cb}}; _ : @pink_err(#sub)}(vb)
          _ : @pink_err(#sub)
        }(va)
      #Mul: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na * nb)}); _ : @pink_err(#mul)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mul{ca, cb}}; _ : @pink_err(#mul)}(vb)
          _ : @pink_err(#mul)
        }(va)
      #Eql: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na == nb)}); _ : @pink_err(#eql)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Eql{ca, cb}}; _ : @pink_err(#eql)}(vb)
          _ : @pink_err(#eql)
        }(va)
      #Lt: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na < nb)}); _ : @pink_err(#lt)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Lt{ca, cb}}; _ : @pink_err(#lt)}(vb)
          _ : @pink_err(#lt)
        }(va)
      #Gt: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na > nb)}); _ : @pink_err(#gt)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Gt{ca, cb}}; _ : @pink_err(#gt)}(vb)
          _ : @pink_err(#gt)
        }(va)
      #Le: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na <= nb)}); _ : @pink_err(#le)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Le{ca, cb}}; _ : @pink_err(#le)}(vb)
          _ : @pink_err(#le)
        }(va)
      #Ge: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na >= nb)}); _ : @pink_err(#ge)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Ge{ca, cb}}; _ : @pink_err(#ge)}(vb)
          _ : @pink_err(#ge)
        }(va)
      #Div: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na / nb)}); _ : @pink_err(#div)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Div{ca, cb}}; _ : @pink_err(#div)}(vb)
          _ : @pink_err(#div)
        }(va)
      #Mod: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cst: λ&na. λ{#Cst: λ&nb. @pink_lift(#Cst{(na % nb)}); _ : @pink_err(#mod)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#Mod{ca, cb}}; _ : @pink_err(#mod)}(vb)
          _ : @pink_err(#mod)
        }(va)
      #And: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: @pink_lift(#Cst{0}); λ&m. @purple_evalc(#MEnv{env, handlers, parent, level})(b)}(na)
          #Cod: λ&ca.
            !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
            λ{#Cod: λ&cb. #Cod{#And{ca, cb}}; _ : @pink_err(#and)}(vb)
          _ : @pink_err(#and)
        }(va)
      #Or: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: @purple_evalc(#MEnv{env, handlers, parent, level})(b); λ&m. @pink_lift(#Cst{1})}(na)
          #Cod: λ&ca.
            !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
            λ{#Cod: λ&cb. #Cod{#Or{ca, cb}}; _ : @pink_err(#or)}(vb)
          _ : @pink_err(#or)
        }(va)
      #Not: λ&a.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        λ{
          #Cst: λ&na. λ{0: @pink_lift(#Cst{1}); λ&m. @pink_lift(#Cst{0})}(na)
          #Cod: λ&ca. #Cod{#Not{ca}}
          _ : @pink_err(#not)
        }(va)
      #CON: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#CON{ca, cb}}; _ : @pink_err(#con)}(vb)
          _ : λ&u. @pink_lift(#CON{va, vb})
        }(va)
      #NIL: @pink_lift(#NIL)
      #CHR: λ&c. @pink_lift(#CHR{c})
      #Fst: λ&p.
        !!&vp = @purple_evalc(#MEnv{env, handlers, parent, level})(p);
        λ{
          #CON: λ&a. λ&b. a
          #Cod: λ&pc. #Cod{#Fst{pc}}
          _ : @pink_err(#fst)
        }(vp)
      #Snd: λ&p.
        !!&vp = @purple_evalc(#MEnv{env, handlers, parent, level})(p);
        λ{
          #CON: λ&a. λ&b. b
          #Cod: λ&pc. #Cod{#Snd{pc}}
          _ : @pink_err(#snd)
        }(vp)
      #EM: λ&e.
        %new_parent = @purple_ensure_parent(#MEnv{env, handlers, parent, level});
        @purple_evalc(new_parent)(e)
      #CLam: λ&body.
        %compiled = @purple_evalc(#MEnv{env, handlers, parent, level})(#Lam{body});
        λ{#Cod: λ&code. @purple_evalc(#MEnv{env, handlers, parent, level})(code); _ : @pink_err(#clam)}(compiled)
      #GMta: λ&key.
        !!&vk = @purple_evalc(#MEnv{env, handlers, parent, level})(key);
        @purple_get_handler(handlers)(vk)
      #SMta: λ&key. λ&val.
        !!&vk = @purple_evalc(#MEnv{env, handlers, parent, level})(key);
        !!&vv = @purple_evalc(#MEnv{env, handlers, parent, level})(val);
        @purple_set_handler(#MEnv{env, handlers, parent, level})(vk)(vv)
      #SEq: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        λ{
          #Sym: λ&sa. λ{#Sym: λ&sb. @pink_lift(#Cst{(sa == sb)}); _ : @pink_err(#seq)}(vb)
          #Cod: λ&ca. λ{#Cod: λ&cb. #Cod{#SEq{ca, cb}}; _ : @pink_err(#seq)}(vb)
          _ : @pink_err(#seq)
        }(va)
      #WMnv: λ&m. λ&body.
        !!&new_menv = @purple_evalc(#MEnv{env, handlers, parent, level})(m);
        λ{#MEnv: λ&e. λ&h. λ&p. λ&l. @purple_evalc(new_menv)(body); _ : @pink_err(#wmenv)}(new_menv)
      #CArg: λ&c. λ&i.
        !!&vc = @purple_evalc(#MEnv{env, handlers, parent, level})(c);
        !!&vi = @purple_evalc(#MEnv{env, handlers, parent, level})(i);
        @purple_ctr_arg(vc)(vi)
      #CTag: λ&e.
        !!&ve = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
        @purple_ctr_tag(ve)
      #Eval: λ&e.
        !!&ve = @purple_evalc(#MEnv{env, handlers, parent, level})(e);
        // If result is #Cod{code}, evaluate code; otherwise evaluate ve as syntax
        λ{#Cod: λ&code. @purple_evalc(#MEnv{env, handlers, parent, level})(code); _ : @purple_evalc(#MEnv{env, handlers, parent, level})(ve)}(ve)
      #MLvl: @pink_lift(#Cst{level})
      #Shft: λ&n. λ&e.
        !!&vn = @purple_evalc(#MEnv{env, handlers, parent, level})(n);
        λ{#Cst: λ&cnt. @purple_shift_levels(#MEnv{env, handlers, parent, level})(@purple_evalc)(cnt)(e); _ : @pink_err(#shft)}(vn)
      #Mat: λ&expr. λ&cases.
        !!&val = @purple_evalc(#MEnv{env, handlers, parent, level})(expr);
        @purple_try_cases(#MEnv{env, handlers, parent, level})(@purple_evalc)(val)(cases)
      // Native match
      #NMat: λ&scrutinee. λ&matcher.
        !!&val = @purple_evalc(#MEnv{env, handlers, parent, level})(scrutinee);
        !!&result = matcher(val);
        λ{#CON: λ&body. λ&bindings.
          %new_env = @purple_bind_all(env)(bindings);
          @purple_evalc(#MEnv{new_env, handlers, parent, level})(body)
        ; _ : @pink_err(#nmat)}(result)
      #FFI: λ&name. λ&args.
        %vargs = @purple_eval_list(#MEnv{env, handlers, parent, level})(@purple_evalc)(args);
        #FFI{name, vargs}
      #Do: λ&first. λ&rest.
        !!&vf = @purple_evalc(#MEnv{env, handlers, parent, level})(first);
        @purple_do_continue(#MEnv{env, handlers, parent, level})(@purple_evalc)(vf)(rest)
      // Default handler delegation (compile mode)
      #DefH: λ&name. λ&arg.
        !!&vname = @purple_evalc(#MEnv{env, handlers, parent, level})(name);
        !!&varg = @purple_evalc(#MEnv{env, handlers, parent, level})(arg);
        @purple_call_default_handler(#MEnv{env, handlers, parent, level})(@purple_evalc)(vname)(varg)
      // Error: raise an error with a message
      #ErrR: λ&msg.
        !!&vmsg = @purple_evalc(#MEnv{env, handlers, parent, level})(msg);
        #Err{vmsg}
      // Try: (try expr handler) -> catch errors with handler (compile mode)
      #Try: λ&expr. λ&handler.
        !!&vexpr = @purple_evalc(#MEnv{env, handlers, parent, level})(expr);
        !!&vhandler = @purple_evalc(#MEnv{env, handlers, parent, level})(handler);
        λ{
          #Err: λ&msg. @purple_apply_menv(#MEnv{env, handlers, parent, level})(@purple_evalc)(vhandler)(msg)
          λ&u. vexpr
        }(vexpr)
      // Assert: (assert cond msg) -> raise error if cond is false (compile mode)
      #Asrt: λ&cond. λ&msg.
        !!&vcond = @purple_evalc(#MEnv{env, handlers, parent, level})(cond);
        λ{
          #Cst: λ&n. λ{0: !!&vmsg = @purple_evalc(#MEnv{env, handlers, parent, level})(msg); #Err{vmsg}; λ&u. @pink_lift(#Cst{1})}(n)
          λ&u. @pink_err(#asrt)
        }(vcond)
      // Trace: (trace expr) -> evaluate and return #Traced{value} (compile mode)
      #Trce: λ&expr.
        !!&vexpr = @purple_evalc(#MEnv{env, handlers, parent, level})(expr);
        #Traced{vexpr}
      // Reify-env: return current environment (compile mode)
      #REnv: @pink_lift(env)
      // Gensym: generate unique symbol (compile mode)
      #GSym: λ&n.
        !!&vn = @purple_evalc(#MEnv{env, handlers, parent, level})(n);
        λ{#Cst: λ&idx. @pink_lift(#Sym{(10000000 + idx)}); λ&u. @pink_err(#gsym)}(vn)
      // Quasiquote: process expression, evaluating unquotes in compile mode
      #QQ: λ&inner.
        @purple_qq_process(#MEnv{env, handlers, parent, level})(@purple_evalc)(inner)
      // Unquote outside quasiquote is an error
      #UQ: λ&inner.
        @pink_err(#uq)
      // Unquote-splicing outside quasiquote is an error
      #UQS: λ&inner.
        @pink_err(#uqs)
      // List operations (compile mode)
      #Map: λ&fn. λ&lst.
        !!&vfn = @purple_evalc(#MEnv{env, handlers, parent, level})(fn);
        !!&vlst = @purple_evalc(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_map(#MEnv{env, handlers, parent, level})(vfn)(vlst)
      #Fltr: λ&fn. λ&lst.
        !!&vfn = @purple_evalc(#MEnv{env, handlers, parent, level})(fn);
        !!&vlst = @purple_evalc(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_filter(#MEnv{env, handlers, parent, level})(vfn)(vlst)
      #Fold: λ&fn. λ&init. λ&lst.
        !!&vfn = @purple_evalc(#MEnv{env, handlers, parent, level})(fn);
        !!&vinit = @purple_evalc(#MEnv{env, handlers, parent, level})(init);
        !!&vlst = @purple_evalc(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_foldr(#MEnv{env, handlers, parent, level})(vfn)(vinit)(vlst)
      #FdLf: λ&fn. λ&init. λ&lst.
        !!&vfn = @purple_evalc(#MEnv{env, handlers, parent, level})(fn);
        !!&vinit = @purple_evalc(#MEnv{env, handlers, parent, level})(init);
        !!&vlst = @purple_evalc(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_foldl(#MEnv{env, handlers, parent, level})(vfn)(vinit)(vlst)
      #Len: λ&lst.
        !!&vlst = @purple_evalc(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_length(vlst)
      #Apnd: λ&a. λ&b.
        !!&va = @purple_evalc(#MEnv{env, handlers, parent, level})(a);
        !!&vb = @purple_evalc(#MEnv{env, handlers, parent, level})(b);
        @purple_list_append(va)(vb)
      #Rev: λ&lst.
        !!&vlst = @purple_evalc(#MEnv{env, handlers, parent, level})(lst);
        @purple_list_reverse(vlst)
      // Higher-order function utilities
      #Comp: λ&f. λ&g.
        !!&vf = @purple_evalc(#MEnv{env, handlers, parent, level})(f);
        !!&vg = @purple_evalc(#MEnv{env, handlers, parent, level})(g);
        @purple_compose(#MEnv{env, handlers, parent, level})(vf)(vg)
      #Flip: λ&f.
        !!&vf = @purple_evalc(#MEnv{env, handlers, parent, level})(f);
        @purple_flip(#MEnv{env, handlers, parent, level})(vf)
      #Appl: λ&f. λ&args.
        !!&vf = @purple_evalc(#MEnv{env, handlers, parent, level})(f);
        !!&vargs = @purple_evalc(#MEnv{env, handlers, parent, level})(args);
        @purple_apply_to_list(#MEnv{env, handlers, parent, level})(vf)(vargs)
      _ : @pink_err(#pexp)
    }(exp)
  ; _ : @pink_err(#menv)}(menv)

// =============================================================================
// Quasiquote Processing
// =============================================================================

// Process a quasiquoted expression - converts to code representation
// When encountering #UQ{e}, evaluate e and splice the result
// When encountering #UQS{e} in a list context, evaluate e and splice elements
@purple_qq_process = λmenv. λ&eval_fn. λexp.
  !!&m = menv; !!&evf = eval_fn; %e = exp;
  λ{
    // Unquote: evaluate and splice result
    // If result is #Cod{e}, unwrap to e (for macro expansion)
    #UQ: λ&inner.
      !!&v = evf(m)(inner);
      // NOTE: Must use λ&u. instead of _ : to properly consume the matched value in HVM4
      λ{#Cod: λ&code. code; λ&u. v}(v)
    // Unquote-splicing outside list context is an error
    #UQS: λ&inner.
      @pink_err(#uqs)
    // Literals become code literals
    #Lit: λ&n. #Lit{n}
    // Symbols become code symbols
    #Sym: λ&s. #Sym{s}
    // Characters become code characters
    #CHR: λ&c. #CHR{c}
    // Nil becomes code nil
    #NIL: #NIL
    // Cons cells: handle UQS in the head position for splicing
    #CON: λ&a. λ&b.
      @purple_qq_cons(m)(evf)(a)(b)
    // Variables become code variables
    #Var: λ&n. #Var{n}
    // Lambda: process body
    #Lam: λ&body. #Lam{@purple_qq_process(m)(evf)(body)}
    // Application: process both sides
    #App: λ&f. λ&x.
      #App{@purple_qq_process(m)(evf)(f), @purple_qq_process(m)(evf)(x)}
    // Let: process value and body
    #Let: λ&val. λ&body.
      #Let{@purple_qq_process(m)(evf)(val), @purple_qq_process(m)(evf)(body)}
    // If: process all branches
    #If: λ&c. λ&t. λ&e.
      #If{@purple_qq_process(m)(evf)(c), @purple_qq_process(m)(evf)(t), @purple_qq_process(m)(evf)(e)}
    // Arithmetic operations
    #Add: λ&a. λ&b.
      #Add{@purple_qq_process(m)(evf)(a), @purple_qq_process(m)(evf)(b)}
    #Sub: λ&a. λ&b.
      #Sub{@purple_qq_process(m)(evf)(a), @purple_qq_process(m)(evf)(b)}
    #Mul: λ&a. λ&b.
      #Mul{@purple_qq_process(m)(evf)(a), @purple_qq_process(m)(evf)(b)}
    #Eql: λ&a. λ&b.
      #Eql{@purple_qq_process(m)(evf)(a), @purple_qq_process(m)(evf)(b)}
    // Nested quasiquote: process recursively (increment depth would be proper, but simplified here)
    #QQ: λ&inner. #QQ{@purple_qq_process(m)(evf)(inner)}
    // Default: return as-is (for unknown constructs)
    _ : e
  }(e)

// Process cons cell in quasiquote context, handling UQS splicing
// UQS can appear in head position (splice into list) or tail position (becomes tail)
@purple_qq_cons = λmenv. λ&eval_fn. λhead. λtail.
  !!&m = menv; !!&evf = eval_fn; !!&h = head; !!&t = tail;
  λ{
    // Unquote-splicing in head position: evaluate and splice list elements
    #UQS: λ&inner.
      !!&lst = evf(m)(inner);
      !!&processed_tail = @purple_qq_process_tail(m)(evf)(t);
      @purple_qq_splice(lst)(processed_tail)
    // Regular head: process head, then check tail for UQS
    _ : λ&u.
      !!&processed_head = @purple_qq_process(m)(evf)(h);
      !!&processed_tail = @purple_qq_process_tail(m)(evf)(t);
      #CON{processed_head, processed_tail}
  }(h)

// Process tail of a cons cell, handling UQS specially
// When tail is UQS{expr}, evaluate expr and use as tail directly
@purple_qq_process_tail = λmenv. λ&eval_fn. λtail.
  !!&m = menv; !!&evf = eval_fn; %t = tail;
  λ{
    // Unquote-splicing in tail position: evaluate and use as tail
    #UQS: λ&inner.
      evf(m)(inner)
    // Regular tail: process normally
    _ : λ&u.
      @purple_qq_process(m)(evf)(t)
  }(t)

// Splice a list into a tail
@purple_qq_splice = λlst. λtail.
  %l = lst; %t = tail;
  λ{
    #NIL: t
    #CON: λ&h. λ&rest. #CON{h, @purple_qq_splice(rest)(t)}
    _ : @pink_err(#spli)
  }(l)

// =============================================================================
// List Operations
// =============================================================================

// Map: apply function to each element
@purple_list_map = λmenv. λ&fn. λlst.
  !!&m = menv; %l = lst;
  λ{
    #NIL: #NIL
    #CON: λ&h. λ&t.
      !!&vh = @purple_apply_menv(m)(@purple_eval)(fn)(h);
      !!&vt = @purple_list_map(m)(fn)(t);
      #CON{vh, vt}
    _ : @pink_err(#map)
  }(l)

// Filter: keep elements where predicate returns non-zero
@purple_list_filter = λmenv. λ&fn. λlst.
  !!&m = menv; %l = lst;
  λ{
    #NIL: #NIL
    #CON: λ&h. λ&t.
      !!&test = @purple_apply_menv(m)(@purple_eval)(fn)(h);
      !!&rest = @purple_list_filter(m)(fn)(t);
      λ{
        #Cst: λ&n. λ{0: rest; λ&u. #CON{h, rest}}(n)
        _ : @pink_err(#fltr)
      }(test)
    _ : @pink_err(#fltr)
  }(l)

// Foldr: right fold - f a (f b (f c init))
@purple_list_foldr = λmenv. λ&fn. λinit. λlst.
  !!&m = menv; %i = init; %l = lst;
  λ{
    #NIL: i
    #CON: λ&h. λ&t.
      !!&rest = @purple_list_foldr(m)(fn)(i)(t);
      @purple_apply2(m)(@purple_eval)(fn)(h)(rest)
    _ : @pink_err(#fold)
  }(l)

// Foldl: left fold - f (f (f init a) b) c
@purple_list_foldl = λmenv. λ&fn. λacc. λlst.
  !!&m = menv; %a = acc; %l = lst;
  λ{
    #NIL: a
    #CON: λ&h. λ&t.
      !!&new_acc = @purple_apply2(m)(@purple_eval)(fn)(a)(h);
      @purple_list_foldl(m)(fn)(new_acc)(t)
    _ : @pink_err(#fdlf)
  }(l)

// Apply function with two arguments
@purple_apply2 = λm. λ&evf. λ&fn. λa. λb.
  !!&menv = m; !!&f1 = fn; !!&arg1 = a; !!&arg2 = b;
  !!&partial = @purple_apply_menv(menv)(evf)(f1)(arg1);
  @purple_apply_menv(menv)(evf)(partial)(arg2)

// Length: count elements
@purple_list_length = λlst.
  %l = lst;
  λ{
    #NIL: #Cst{0}
    #CON: λ&h. λ&t.
      !!&rest_len = @purple_list_length(t);
      λ{#Cst: λ&n. #Cst{(n + 1)}; _ : @pink_err(#len)}(rest_len)
    _ : @pink_err(#len)
  }(l)

// Append: concatenate two lists
@purple_list_append = λa. λb.
  %l1 = a; %l2 = b;
  λ{
    #NIL: l2
    #CON: λ&h. λ&t. #CON{h, @purple_list_append(t)(l2)}
    _ : @pink_err(#apnd)
  }(l1)

// Reverse: reverse a list
@purple_list_reverse = λlst.
  @purple_list_reverse_acc(lst)(#NIL)

@purple_list_reverse_acc = λlst. λacc.
  %l = lst; %a = acc;
  λ{
    #NIL: a
    #CON: λ&h. λ&t. @purple_list_reverse_acc(t)(#CON{h, a})
    _ : @pink_err(#rev)
  }(l)

// =============================================================================
// Higher-Order Function Utilities
// =============================================================================

// Compose: (compose f g) returns a closure that when applied to x gives f(g(x))
@purple_compose = λmenv. λ&vf. λ&vg.
  // Return a closure that captures f and g
  // Env: #CON{f, #CON{g, #NIL}}
  // When applied to x: env becomes #CON{x, #CON{f, #CON{g, #NIL}}}
  // #Var{0} = x, #Var{1} = f, #Var{2} = g
  // Body: f(g(x)) = #App{#Var{1}, #App{#Var{2}, #Var{0}}}
  #Clo{#CON{vf, #CON{vg, #NIL}}, #App{#Var{1}, #App{#Var{2}, #Var{0}}}}

// Flip: (flip f) returns a function with swapped argument order
// (flip f x y) = (f y x)
@purple_flip = λmenv. λ&vf.
  // Return a closure that captures f
  // Env: #CON{f, #NIL}
  // When applied to x: env becomes #CON{x, #CON{f, #NIL}}
  // #Var{0} = x, #Var{1} = f
  // Body is a lambda: λy. (f y x)
  // When that lambda is applied to y: #CON{y, #CON{x, #CON{f, #NIL}}}
  // #Var{0} = y, #Var{1} = x, #Var{2} = f
  // Inner body: ((f y) x) = #App{#App{#Var{2}, #Var{0}}, #Var{1}}
  #Clo{#CON{vf, #NIL}, #Lam{#App{#App{#Var{2}, #Var{0}}, #Var{1}}}}

// Apply: apply a function to a list of arguments
// (apply f '(a b c)) = (((f a) b) c)
@purple_apply_to_list = λmenv. λ&func. λargs.
  !!&m = menv; %f = func; %l = args;
  λ{
    #NIL: f
    #CON: λ&h. λ&t.
      !!&applied = @purple_apply_menv(m)(@purple_eval)(f)(h);
      @purple_apply_to_list(m)(applied)(t)
    _ : @pink_err(#appl)
  }(l)

@purple_unwrap = λ&v.
  λ{
    #Cst: λ&n. n
    #Fix: λ&hi. λ&lo. λ&scale. #Fix{hi, lo, scale}
    #Ptr: λ&hi. λ&lo. #Ptr{hi, lo}
    #Sym: λ&s. #Sym{s}
    #CHR: λ&c. #CHR{c}
    #CON: λ&a. λ&b. #CON{@purple_unwrap(a), @purple_unwrap(b)}
    #NIL: #NIL
    #Cod: λ&e. #Cod{e}
    #Clo: λ&env. λ&body. #Clo{env, body}
    #CloR: λ&env. λ&body. #CloR{env, body}
    #MEnv: λ&e.λ&h.λ&p.λ&l. #MEnv{e, h, p, l}
    #FFI: λ&name. λ&args. #FFI{name, @purple_unwrap_list(args)}
    #Do: λ&first. λ&rest. #Do{@purple_unwrap(first), @purple_unwrap(rest)}
    #WMnv: λ&m. λ&b. #WMnv{@purple_unwrap(m), @purple_unwrap(b)}
    #DefH: λ&n. λ&a. #DefH{@purple_unwrap(n), @purple_unwrap(a)}
    #ErrR: λ&m. #ErrR{@purple_unwrap(m)}
    #Err: λ&m. #Err{@purple_unwrap(m)}
    #Try: λ&e. λ&h. #Try{@purple_unwrap(e), @purple_unwrap(h)}
    #Asrt: λ&c. λ&m. #Asrt{@purple_unwrap(c), @purple_unwrap(m)}
    #Trce: λ&e. #Trce{@purple_unwrap(e)}
    #Traced: λ&v. #Traced{@purple_unwrap(v)}
    // AST nodes that may appear in unevaluated code (for FFI continuations)
    #Lit: λ&n. #Lit{n}
    #Var: λ&n. #Var{n}
    #Lam: λ&b. #Lam{@purple_unwrap(b)}
    #App: λ&f. λ&x. #App{@purple_unwrap(f), @purple_unwrap(x)}
    #Let: λ&v. λ&b. #Let{@purple_unwrap(v), @purple_unwrap(b)}
    #If: λ&c. λ&t. λ&e. #If{@purple_unwrap(c), @purple_unwrap(t), @purple_unwrap(e)}
    #Add: λ&a. λ&b. #Add{@purple_unwrap(a), @purple_unwrap(b)}
    #Sub: λ&a. λ&b. #Sub{@purple_unwrap(a), @purple_unwrap(b)}
    #Mul: λ&a. λ&b. #Mul{@purple_unwrap(a), @purple_unwrap(b)}
    _ : @pink_err(#punw)
  }(v)

@purple_unwrap_list = λ&lst.
  λ{
    #NIL: #NIL
    #CON: λ&h. λ&t. #CON{@purple_unwrap(h), @purple_unwrap_list(t)}
    _ : lst
  }(lst)
