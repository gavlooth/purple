;; A mini-evaluator using pattern matching
;; Demonstrates the power of match for building interpreters

(let (my-eval (lambda self (expr)
  (match expr
    ((Lit n) n)
    ((Add a b) (+ (self a) (self b)))
    ((Mul a b) (* (self a) (self b)))
    (_ 0))))

  ;; Evaluate: (+ (* 3 4) 5) = 17
  (my-eval (quote (+ (* 3 4) 5))))
